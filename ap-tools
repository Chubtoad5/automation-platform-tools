run_uninstall_ap_bundle () {
  echo "  Removing Dell Automation Platform staging artifacts (bundle tree, cmd file, registry trust)..."
  echo "  NOTE: this does NOT uninstall DAP itself - DAP runs inside the RKE2 cluster and is removed"
  echo "  with the cluster ('uninstall rke2') or via Dell's own uninstall procedure. Docker is kept."
  local ca_path reg_fqdn certsd_dir
  ca_path=$(state_get AP_REG_CA_PATH)
  reg_fqdn=$(state_get AP_REG_FQDN)
  certsd_dir=$(state_get AP_REG_CERTSD_DIR)
  if [[ -z "$ca_path" ]]; then
    # No CA path recorded. Two ways to land here:
    #   1. a pre-state-file install  -> nothing recorded, use the -registry argument
    #   2. an install that died between recording AP_REG_FQDN (early) and AP_REG_CA_PATH
    #      (written only after the bundle download) -> the FQDN *is* recorded, so prefer it
    #      and don't make the operator re-supply what we already know.
    local fallback_fqdn="${reg_fqdn:-$REG_FQDN}"
    if [[ -n "$fallback_fqdn" ]]; then
      local p
      for p in "/usr/local/share/ca-certificates/$fallback_fqdn.crt" "/etc/pki/ca-trust/source/anchors/$fallback_fqdn.crt" "/etc/pki/trust/anchors/$fallback_fqdn.crt"; do
        [[ -f "$p" ]] && ca_path="$p"
      done
    fi
    # Only derive certs.d from the ambient -registry value, and only when nothing was
    # recorded. REGISTRY_INFO is empty unless -registry was passed, and an empty value here
    # would yield the bare '/etc/docker/certs.d/' directory - which the -d test below would
    # accept and rm -rf wholesale. Never let that happen.
    if [[ -z "$certsd_dir" && -n "$REGISTRY_INFO" ]]; then
      certsd_dir="/etc/docker/certs.d/$REGISTRY_INFO"
    fi
  fi
  if [[ -n "$ca_path" && -f "$ca_path" ]]; then
    echo "  Removing registry CA from the system trust store: $ca_path"
    rm -f "$ca_path"
    if command -v update-ca-certificates >/dev/null 2>&1; then
      update-ca-certificates >/dev/null 2>&1 || true
    elif command -v update-ca-trust >/dev/null 2>&1; then
      update-ca-trust extract 2>/dev/null || true
    fi
  else
    echo "  No registry CA recorded/found to remove. (On hosts installed before state tracking,"
    echo "  pass '-registry <host:port> <user> <pass>' so the CA file can be located.)"
  fi
  if [[ -n "$certsd_dir" && -d "$certsd_dir" ]]; then
    echo "  Removing docker registry cert dir: $certsd_dir"
    rm -rf "$certsd_dir"
  fi
  rm -rf "$WORKING_DIR/bundle"
  local cmd_file
  cmd_file=$(state_get AP_CMD_FILE)
  [[ -z "$cmd_file" ]] && cmd_file="$base_dir/ap-install-upgrade-cmd.txt"
  rm -f "$cmd_file"
  state_unset AP_REG_CA_PATH
  state_unset AP_REG_FQDN
  state_unset AP_REG_CERTSD_DIR
  state_unset AP_CMD_FILE
  echo "  ap-bundle staging removed. The bundle zip and cached sub-installers are kept -"
  echo "  re-run with --purge-cache to remove the whole $WORKING_DIR tree (~20GB)."
}

run_uninstall_ddpc_bundle () {
  echo "  Removing Dell Distributed Private Cloud staging artifacts (ddpc-bundle tree, cmd file, DDPC-only registry trust)..."
  echo "  NOTE: this does NOT uninstall DDPC itself - it runs inside the DAP orchestrator namespace."
  local dir cmd_file
  dir=$(state_get DDPC_BUNDLE_DIR)
  [[ -z "$dir" ]] && dir="$DDPC_BUNDLE_DIR"
  cmd_file=$(state_get DDPC_CMD_FILE)
  [[ -z "$cmd_file" ]] && cmd_file="$base_dir/ddpc-install-upgrade-cmd.txt"
  rm -rf "${dir:?}"
  rm -f "$cmd_file"
  # Registry trust is removed only when 'install ddpc-bundle -registry' pointed at a registry
  # other than the one DAP itself uses (the ap-bundle keys stay authoritative for that one).
  local ddpc_fqdn ddpc_ca ddpc_certsd ap_fqdn
  ddpc_fqdn=$(state_get DDPC_REG_FQDN)
  ddpc_ca=$(state_get DDPC_REG_CA_PATH)
  ddpc_certsd=$(state_get DDPC_REG_CERTSD_DIR)
  ap_fqdn=$(state_get AP_REG_FQDN)
  if [[ -n "$ddpc_fqdn" && "$ddpc_fqdn" != "$ap_fqdn" ]]; then
    if [[ -n "$ddpc_ca" && -f "$ddpc_ca" ]]; then
      echo "  Removing the DDPC-only registry CA from the system trust store: $ddpc_ca"
      rm -f "$ddpc_ca"
      if command -v update-ca-certificates >/dev/null 2>&1; then
        update-ca-certificates >/dev/null 2>&1 || true
      elif command -v update-ca-trust >/dev/null 2>&1; then
        update-ca-trust extract 2>/dev/null || true
      fi
    fi
    if [[ -n "$ddpc_certsd" && -d "$ddpc_certsd" ]]; then
      echo "  Removing the DDPC-only docker registry cert dir: $ddpc_certsd"
      rm -rf "$ddpc_certsd"
    fi
  fi
  state_unset DDPC_BUNDLE_DIR
  state_unset DDPC_BUNDLE_FILE
  state_unset DDPC_CMD_FILE
  state_unset DDPC_REG_FQDN
  state_unset DDPC_REG_CA_PATH
  state_unset DDPC_REG_CERTSD_DIR
  echo "  ddpc-bundle staging removed. The DDPC zip is kept - re-run with --purge-cache to remove the whole $WORKING_DIR tree."
  echo "  To remove DDPC from the cluster (Dell's own uninstall), run:"
  echo "    export KUBECONFIG=/etc/rancher/rke2/rke2.yaml"
  echo "    helm uninstall dell-distributed-private-cloud -n $ORCHESTRATOR_NAMESPACE --wait --timeout ${DDPC_INSTALL_TIMEOUT}s"
  echo "    kubectl -n $ORCHESTRATOR_NAMESPACE delete configmap distpvtcloud-custom-values distpvtcloud-image-push-status distpvtcloud-checkpoint-data --ignore-not-found"
  echo "    kubectl -n $ORCHESTRATOR_NAMESPACE delete secret distpvtcloud-docker-secret --ignore-not-found"
}

purge_cache_tree () {
  echo "  --purge-cache: removing the ap-tools working cache..."
  rm -rf "${WORKING_DIR:?}"
  rm -rf "${base_dir:?}/LICENSES"
