# jq helpers shared by the resource gates (AP-2): normalise every Kubernetes quantity to a
# NUMBER - millicores -> cores; memory/ephemeral-storage -> GB (Ki/Mi/Gi/Ti binary suffixes,
# K/M/G/T decimal, bare = bytes) - so multi-node 'add' sums instead of concatenating strings.
ap_jq_qty_defs='
    def cpu_cores: if (type == "string" and test("m$")) then (sub("m$"; "") | tonumber) / 1000 else tonumber end;
    def qty_gb:
      if type != "string" then (tonumber / 1073741824)
      elif test("Ki$") then (sub("Ki$"; "") | tonumber) / 1048576
      elif test("Mi$") then (sub("Mi$"; "") | tonumber) / 1024
      elif test("Gi$") then (sub("Gi$"; "") | tonumber)
      elif test("Ti$") then (sub("Ti$"; "") | tonumber) * 1024
      elif test("[Kk]$") then (sub("[Kk]$"; "") | tonumber) / 1000000
      elif test("M$") then (sub("M$"; "") | tonumber) / 1000
      elif test("G$") then (sub("G$"; "") | tonumber)
      elif test("T$") then (sub("T$"; "") | tonumber) * 1000
      else (tonumber / 1073741824) end;'
# Cluster resource gates, measured against ALLOCATABLE resources (not provisioned) after the
# cluster is up. Aligned to DAP 2.1.1.0, whose own pre_install_check enforces
# REQUIRED_CPU=12000m / REQUIRED_MEMORY=24Gi / REQUIRED_DISK_SPACE=850Gi against each node's
# allocatable ephemeral-storage. We keep CPU/memory above Dell's floor as the supported spec.
