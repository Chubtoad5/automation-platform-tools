  echo "  Installing helm binary..."
  rm -rf $WORKING_DIR/ap-utilities/helm/extract
  mkdir -p $WORKING_DIR/ap-utilities/helm/extract
  tar -xzf $WORKING_DIR/ap-utilities/helm/helm-v$HELM_VERSION-linux-amd64.tar.gz -C $WORKING_DIR/ap-utilities/helm/extract
