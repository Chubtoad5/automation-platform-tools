  name: longhorn-nodeport-svc
  namespace: longhorn-system
spec:
  type: NodePort
  ports:
  - name: http
    nodePort: 31000
    port: 80
    protocol: TCP
    targetPort: http
  selector:
    app: longhorn-ui
  sessionAffinity: None
EOF
    kubectl apply -f $WORKING_DIR/ap-utilities/helm/longhorn/longhornNodePort.yaml
  fi
}

