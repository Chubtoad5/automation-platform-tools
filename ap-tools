check_rke2_service_running () {
    # AP-1: an already-running RKE2 node is NO LONGER a hard stop. rke2_installer.sh
    # now reconciles a running node itself: identical env -> no-op (exit 0); changed
    # config -> requires RKE2_RECONFIGURE=true; version drift -> error directing to
    # 'upgrade'. ap-tools proceeds and re-applies its add-ons idempotently
    # (helm upgrade --install). The only remaining ap-tools-side hard error is a
    # join to a DIFFERENT cluster, which always requires an uninstall first.
    # AP-18: pure 'push' never blocks on the local rke2 service state.
    if [[ $INSTALL_MODE -eq 0 && $JOIN_MODE -eq 0 ]]; then
        return 0
    fi
    local active_svc=""
    if systemctl is-active --quiet rke2-server.service; then
        active_svc="rke2-server.service"
    elif systemctl is-active --quiet rke2-agent.service; then
        active_svc="rke2-agent.service"
    fi
    if [[ -z "$active_svc" ]]; then
        return 0
    fi
    if [[ $JOIN_MODE -eq 1 && -f /etc/rancher/rke2/config.yaml ]]; then
        local existing_server=""
        existing_server=$(awk -F'https://' '/^server:/ {print $2}' /etc/rancher/rke2/config.yaml | cut -d: -f1) || true
        if [[ -n "$existing_server" && "$existing_server" != "$JOIN_SERVER_FQDN" ]]; then
            echo "Error: this node is already joined to cluster server '$existing_server', but a join to"
            echo "  '$JOIN_SERVER_FQDN' was requested. Joining a different cluster requires an uninstall first:"
            echo "  sudo ./$SCRIPT_NAME uninstall rke2"
            exit 1
        fi
    fi
    echo "  $active_svc is already active: continuing in reconcile mode."
    if [[ "$active_svc" == "rke2-server.service" ]]; then
        if KUBECONFIG=/etc/rancher/rke2/rke2.yaml /var/lib/rancher/rke2/bin/kubectl get nodes >/dev/null 2>&1; then
            echo "  Cluster is healthy ('kubectl get nodes' responds)."
