ap_preflight_checks () {
  # Check k8s for the required resources and NTP sync
  echo "  Running pre-flight resource checks..."
  # AP-2: normalise every quantity to a NUMBER inside jq before 'add'. The old
  # sub()-only pipeline returned strings, so multi-node 'add' CONCATENATED them
  # ("16"+"16"+"16" -> "161616") and the resource gate was silently disabled on
  # exactly the clusters where it matters. Units: millicores -> cores; memory and
  # ephemeral-storage -> GB (Ki/Mi/Gi/Ti binary suffixes, K/M/G/T decimal, bare = bytes).
  ALLOCATABLE_JSON=$(kubectl get nodes -o json | jq -c "$ap_jq_qty_defs"'
    {cpu: ([.items[]?.status.allocatable.cpu | cpu_cores] | add),
     memory_gb: ([.items[]?.status.allocatable.memory | qty_gb] | add),
     storage_gb: ([.items[]?.status.allocatable."ephemeral-storage" | qty_gb] | add)}' || true)
  if [ -z "$ALLOCATABLE_JSON" ] || [ "$ALLOCATABLE_JSON" = "null" ]; then
    echo "Error: Could not retrieve or parse allocatable resource data. Check kubectl connectivity and 'jq' installation."
    exit 1
  fi
  CURRENT_CPU=$(echo "$ALLOCATABLE_JSON" | jq -r '.cpu')
  CURRENT_MEM_GB=$(echo "$ALLOCATABLE_JSON" | jq -r '.memory_gb')
  CURRENT_STORAGE_GB=$(echo "$ALLOCATABLE_JSON" | jq -r '.storage_gb')
  if [ -z "$CURRENT_CPU" ] || [ "$CURRENT_CPU" = "null" ]; then CURRENT_CPU=0; fi
  if [ -z "$CURRENT_MEM_GB" ] || [ "$CURRENT_MEM_GB" = "null" ]; then CURRENT_MEM_GB=0; fi
  if [ -z "$CURRENT_STORAGE_GB" ] || [ "$CURRENT_STORAGE_GB" = "null" ]; then CURRENT_STORAGE_GB=0; fi
  # Trim to one decimal for display/comparison; bc -l handles the fractions.
  CURRENT_CPU=$(LC_ALL=C printf '%.2f' "$CURRENT_CPU")
  CURRENT_MEM_GB=$(LC_ALL=C printf '%.1f' "$CURRENT_MEM_GB")
  CURRENT_STORAGE_GB=$(LC_ALL=C printf '%.1f' "$CURRENT_STORAGE_GB")
  EXIT_CODE=0
  if (( $(echo "$CURRENT_CPU < $REQUIRED_CPU" | bc -l) )); then
    echo "Error: Not enough CPU resources available. Required: $REQUIRED_CPU, Available: $CURRENT_CPU"
    EXIT_CODE=1
  fi

  if (( $(echo "$CURRENT_MEM_GB < $REQUIRED_MEM_GB" | bc -l) )); then
    echo "Error: Not enough memory resources available. Required: $REQUIRED_MEM_GB, Available: $CURRENT_MEM_GB"
    EXIT_CODE=1
  fi

  if (( $(echo "$CURRENT_STORAGE_GB < $REQUIRED_STORAGE_GB" | bc -l) )); then
    echo "Error: Not enough storage resources available. Required: $REQUIRED_STORAGE_GB, Available: $CURRENT_STORAGE_GB"
    EXIT_CODE=1
  fi

  if [ $EXIT_CODE -eq 0 ]; then
    echo "🎉 Cluster resource check PASSED."
    echo "  CPU: $CURRENT_CPU"
    echo "  Memory: $CURRENT_MEM_GB GB"
    echo "  Storage: $CURRENT_STORAGE_GB GB"
  else
    echo "🛑 Cluster resource check FAILED. Exiting."
    exit 1
  fi
  ntp_preflight_check
}

ntp_preflight_check () {
  # Shared by the ap-bundle and ddpc-bundle pre-flights: warns (never fails) on an
  # unsynchronised clock and verifies a user-defined NTP_SERVERS source is the active one.
  # Check NTP status
  ntp_status=$(timedatectl status | awk '/System clock synchronized/ {print $NF}') || true
  ntp_message="NTP is synchronized!"
  if [ "$ntp_status" != "yes" ]; then
    echo "WARNING: NTP is not synchronized! This may cause Kubernetes pod connectivity issues, use the 'timedatectl' command to check the status."
    ntp_message="WARNING: NTP is not synchronized or timedatectl command failed! This may cause Kubernetes pod connectivity issues, use the 'timedatectl' command to check the status."
  fi
  # When a user-defined NTP source was configured during 'install rke2', verify it is actually in use
  if [ -n "${NTP_SERVERS// /}" ]; then
    local want_ntp active_ntp
    want_ntp=$(echo "$NTP_SERVERS" | tr ',' ' ' | xargs)
    active_ntp=$(timedatectl show-timesync 2>/dev/null | awk -F= '/^ServerName=|^ServerAddress=/ {print $2}' | xargs)
    if command -v chronyc >/dev/null 2>&1; then
      active_ntp="$active_ntp $(chronyc -n sources 2>/dev/null | awk 'NR>2 {print $2}' | xargs)"
    fi
    local ntp_ok=1
    for s in $want_ntp; do
      echo "$active_ntp" | grep -qw "$s" || ntp_ok=0
    done
    if [ "$ntp_ok" -eq 1 ]; then
      echo "  NTP source verification PASSED — configured server(s) in use: $want_ntp"
      ntp_message="$ntp_message Configured NTP server(s) verified in use: $want_ntp"
    else
      echo "WARNING: configured NTP_SERVERS ($want_ntp) not found among active sources ($active_ntp). Re-check 'install rke2' NTP config."
      ntp_message="$ntp_message WARNING: configured NTP_SERVERS ($want_ntp) not confirmed active; active sources: $active_ntp"
    fi
  fi
}
dns_pre_flight_checks () {
  # Use this function to check DNS resolution where $1, $2, $3, etc... are the FQDNs to lookup
  # local mtls_dns="mtls-$ORCHESTRATOR_FQDN"
  dns_to_check=()
  failed_lookups=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      *)
        dns_to_check+=("$1")
        shift
        ;;
    esac
  done
  for entry in "${dns_to_check[@]}"; do
    echo "  Running pre-flight dns check for $entry"
    # AP-3: use getent (glibc, always present - incl. minimal images) instead of 'host'
    # (bind-utils/dnsutils, absent on minimal images). Also honors /etc/hosts entries.
    resolved_dns=$(getent hosts "$entry" 2>/dev/null | awk '{ print $1; exit }') || true
    if [ -z "$resolved_dns" ]; then
      failed_lookups+=("$entry")
      echo "  Failed to resolve $entry"
    else
      echo "  Resolved $entry to $resolved_dns"
    fi
  done
  if [ "${#failed_lookups[@]}" -gt 0 ]; then
    echo "  Error: The following FQDNs could not be resolved:"
    for failed_entry in "${failed_lookups[@]}"; do
      echo "  - $failed_entry"
    done
    echo "  Fix name resolution before proceeding"
    exit 1
  fi
}
