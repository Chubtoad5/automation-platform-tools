            echo "  Proceeding - rke2_installer.sh re-validates cluster readiness and fails hard if it does not converge."
        fi
    fi
    echo "  rke2_installer.sh will reconcile: unchanged config is a no-op; a changed config requires RKE2_RECONFIGURE=true."
}

check_namespace_pods_ready() {
  # Run this function as 'check_namespace_pods_ready $namespace', no argument will default to kube-system
  local timeout_seconds=300
  local start_time
  start_time=$(date +%s)
  local ns=${1:-"kube-system"}
  while true; do
    local completed_pods
    completed_pods=$(kubectl get pods -n $ns --field-selector status.phase=Succeeded -o name)
    echo "  Checking pod status and removing Completed pods in $ns namespace..."
    for pod_name in $completed_pods; do
      kubectl delete -n $ns "$pod_name" --ignore-not-found
    done
    local current_pods_not_ready
    current_pods_not_ready=$(kubectl get pods -n $ns --no-headers | awk '{print $2}' | awk -F'/' '{if ($1 != $2) print $0}' | wc -l)
    local elapsed_time=$(($(date +%s) - start_time))
    if [ "$elapsed_time" -ge "$timeout_seconds" ]; then
      echo "Error: Timeout reached after $timeout_seconds seconds. Not all pods are ready." >&2
      kubectl get pods -A
      return 1
    fi
    if [ "$current_pods_not_ready" -eq 0 ]; then
      break
    fi
    echo "  - Wating on $current_pods_not_ready pods..."
    echo "  - Elapsed: ${elapsed_time}s/${timeout_seconds}s"
    sleep 10
  done
  echo "  - All pods are ready in $ns namespace!"
  return 0
}

run_debug() {
  # Runs a step while preserving 'set -e' semantics INSIDE the called function (AP-21).
  # Wrapping "$@" in an if/&&/|| condition would suppress errexit for the whole call
  # tree and let mid-function failures continue silently \u2014 the old failure branch here
  # was dead code for the same reason. On failure, errexit aborts the script and the
  # on_exit trap reports the failing step; with DEBUG=0 the step's captured output is
  # replayed by the trap so failures are never silent.
  RUN_DEBUG_STEP="$*"
  if [ "$DEBUG" = "1" ]; then
    local GREEN NC
    GREEN=$(tput setaf 2 2>/dev/null || true)
    NC=$(tput sgr0 2>/dev/null || true)
    local CHECKMARK='\u2714'
    echo "--- Running '$*' with DEBUG enabled---"
    "$@"
    echo -e "--- DEBUG: Finished '$*' ${GREEN}${CHECKMARK} Success${NC} ---"
  else
    # DEBUG=0: capture output so the on_exit trap can replay it if the step fails.
    : > "$RUN_DEBUG_LOG"
    "$@" > "$RUN_DEBUG_LOG" 2>&1
  fi
  RUN_DEBUG_STEP=""
}

on_exit () {
  # EXIT trap: make failures visible (AP-21) \u2014 reports the failing run_debug step and,
  # when DEBUG=0 swallowed its output, replays it so failures are never silent.
  local rc=$?
  if [[ $rc -ne 0 && -n "${RUN_DEBUG_STEP:-}" ]]; then
    echo "Error: step '$RUN_DEBUG_STEP' failed (exit $rc)." >&2
    if [[ "$DEBUG" != "1" && -s "${RUN_DEBUG_LOG:-/dev/null}" ]]; then
      echo "--- output of failed step '$RUN_DEBUG_STEP' ---" >&2
      cat "$RUN_DEBUG_LOG" >&2
      echo "--- end of failed step output ---" >&2
    fi
  fi
  rm -f "${RUN_DEBUG_LOG:-}"
  exit $rc
}
trap on_exit EXIT

# --- Install-state file helpers (enabler for 'uninstall <component>') --- #
# /var/lib/ap-tools/state.env records host state BEFORE ap-tools changes it, plus what
# ap-tools itself installed, so uninstall reverts ONLY ap-tools' changes.

state_set () {
    # state_set KEY VALUE - idempotent key=value write to the install-state file
    local key="$1" val="$2"
    mkdir -p "$STATE_DIR"
    if [[ -f "$STATE_FILE" ]]; then
        sed -i "/^${key}=/d" "$STATE_FILE"
    fi
    echo "${key}=\"${val}\"" >> "$STATE_FILE"
    chmod 600 "$STATE_FILE"
}

state_get () {
    # state_get KEY - prints the recorded value, empty when absent
    [[ -f "$STATE_FILE" ]] || return 0
    sed -n "s/^${1}=\"\(.*\)\"$/\1/p" "$STATE_FILE" | head -n 1
}

state_record_once () {
    # state_record_once KEY VALUE - like state_set but never overwrites an existing key.
    # Used for pre-install host state so re-runs don't clobber the original record.
    local key="$1" val="$2"
    if [[ -f "$STATE_FILE" ]] && grep -q "^${key}=" "$STATE_FILE"; then
        return 0
    fi
    state_set "$key" "$val"
}

state_unset () {
    # state_unset KEY - removes a key after its recorded change has been reverted
    [[ -f "$STATE_FILE" ]] || return 0
    sed -i "/^${1}=/d" "$STATE_FILE"
}

