run_uninstall () {
  case "$UNINSTALL_TYPE" in
    rke2)       run_uninstall_rke2 ;;
    harbor)     run_uninstall_harbor ;;
    swfs)       run_uninstall_swfs ;;
    velero)     run_uninstall_velero ;;
    monitoring) run_uninstall_monitoring ;;
    ap-bundle)  run_uninstall_ap_bundle ;;
