run_uninstall_harbor () {
  confirm_destructive "'uninstall harbor' removes the Harbor registry from this host, including its stored container images." \
    "install_harbor.sh removes only Harbor's own /data subpaths by default; set PURGE_DATA=true to remove /data entirely."
  if [[ ! -f $WORKING_DIR/ap-utilities/harbor/install_harbor.sh ]]; then
    if [[ $AIR_GAPPED_MODE == "1" && -f $WORKING_DIR/ap-utilities/harbor/harbor-offline-package.tar.gz ]]; then
      cd $WORKING_DIR/ap-utilities/harbor
      tar xzf harbor-offline-package.tar.gz
      cd $base_dir
    else
      fetch_subtool "$WORKING_DIR/ap-utilities/harbor/install_harbor.sh" \
        "https://github.com/Chubtoad5/harbor-registry-installer/raw/refs/heads/$harbor_feature_branch/install_harbor.sh" "$harbor_feature_branch"
    fi
  fi
  cd $WORKING_DIR/ap-utilities/harbor
  # Forward ONLY user-set values: install_harbor.sh's recorded /opt/harbor/.install-env
  # (explicit env > .install-env > default) must stay authoritative for what was
  # actually installed - unconditionally forwarding ap-tools defaults would defeat it.
  local fwd=("DEBUG=$DEBUG")
  [[ -n "$user_set_harbor_cn" ]] && fwd+=("REGISTRY_COMMON_NAME=$HARBOR_COMMON_NAME")
  [[ -n "$user_set_harbor_port" ]] && fwd+=("HARBOR_PORT=$HARBOR_PORT")
  [[ -n "$user_set_harbor_version" ]] && fwd+=("HARBOR_VERSION=$HARBOR_VERSION")
  [[ -n "$user_set_purge_data" ]] && fwd+=("PURGE_DATA=$PURGE_DATA")
  env "${fwd[@]}" ./install_harbor.sh uninstall-harbor
  cd $base_dir
  echo "  harbor uninstall complete."
}

