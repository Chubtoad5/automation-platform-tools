# 34, not 36: the documented host spec is 36 GB provisioned, but the kubelet + OS reserve ~2 GB,
# so a correctly-provisioned 36 GB node reports ~35 GB allocatable. Same 2 GB relationship the
# previous 34-provisioned / 32-allocatable pair used.
REQUIRED_MEM_GB=34
# 850 GB matches DAP 2.1.1.0's ephemeral-storage gate exactly. A 500 GB host used to pass here
# and then fail Dell's own check mid-install.
REQUIRED_STORAGE_GB=850
