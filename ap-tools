fetch_subtool () {
    # AP-7/AP-8/AP-23: single fetcher for every sub-installer script.
    # $1 = destination path, $2 = raw URL, $3 = branch to record for cache invalidation.
    # - curl -f: an HTTP error (404 on a bad branch, etc.) FAILS instead of saving an
    #   HTML error page that would later be executed as a script (AP-7).
    # - temp file + mv: an interrupted fetch never leaves a partial script behind.
    # - The branch is recorded next to the cached file; requesting a different branch
    #   triggers a refetch (AP-8). Cached files without a record are treated as 'main'.
    local dest="$1" url="$2" branch="${3:-main}"
    local branch_file
    branch_file="$(dirname "$dest")/.$(basename "$dest").branch"
    if [[ -f "$dest" ]]; then
        local cached_branch="main"
        [[ -f "$branch_file" ]] && cached_branch=$(cat "$branch_file")
        if [[ "$cached_branch" == "$branch" ]]; then
            return 0
        fi
        echo "  Cached $(basename "$dest") came from branch '$cached_branch' but '$branch' was requested; refetching..."
    fi
    echo "  Downloading $(basename "$dest") (branch: $branch)..."
    if ! curl -fsSL "$url" -o "$dest.tmp"; then
        echo "Error: failed to download $url"
        echo "  Check the branch name and internet connectivity, then retry."
        rm -f "$dest.tmp"
        exit 1
    fi
    mv "$dest.tmp" "$dest"
    chmod +x "$dest"
    echo "$branch" > "$branch_file"
}

