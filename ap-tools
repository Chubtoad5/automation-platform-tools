  fi
  if [[ "$KUBELET_DATA" == "default" ]]; then
    local kubelet_data_path="~"
  else
    local kubelet_data_path="$KUBELET_DATA"
  fi
  local values_yaml=""
  if [[ $CLUSTER_TYPE == "single-node" ]]; then
    cat << EOF > $WORKING_DIR/ap-utilities/helm/longhorn/longhorn-values.yaml
longhornUI:
  replicas: 1
csi:
  kubeletRootDir: $kubelet_data_path
  attacherReplicaCount: 1
  provisionerReplicaCount: 1
  resizerReplicaCount: 1
  snapshotterReplicaCount: 1
defaultSettings:
  defaultDataPath: $pvc_data_path
  defaultReplicaCount: 1
  storageReservedPercentageForDefaultDisk: 10
  storageOverProvisioningPercentage: 100
  storageMinimalAvailablePercentage: 5
persistence:
  defaultClassReplicaCount: 1
EOF
  else
    cat << EOF > $WORKING_DIR/ap-utilities/helm/longhorn/longhorn-values.yaml
csi:
  kubeletRootDir: $kubelet_data_path
defaultSettings:
  defaultDataPath: $pvc_data_path
  defaultReplicaCount: 3
  defaultDataLocality: best-effort
  nodeDownPodDeletionPolicy: delete-statefulset-pod
  storageReservedPercentageForDefaultDisk: 10
  # 400, not 200: over-provisioning is a soft *scheduling* gate (virtual/requested capacity), not a fill
  # cap. DAP's replica-3 footprint is ~1 TiB virtual/node; on 500-600 GiB-class disks 200% (~970 GiB
  # allowance) is too low and large volumes hit ReplicaSchedulingFailure. 400% fits the whole supported
  # disk range with margin; storageMinimalAvailablePercentage below is the real physical guard against fill.
  storageOverProvisioningPercentage: 400
  storageMinimalAvailablePercentage: 10
EOF
  fi
  local values_yaml="-f $WORKING_DIR/ap-utilities/helm/longhorn/longhorn-values.yaml"
  # AP-1: 'upgrade --install' converges on re-runs instead of failing on an existing release
  if [[ $AIR_GAPPED_MODE == "0" ]]; then
    /usr/local/bin/helm upgrade --install longhorn longhorn/longhorn --namespace longhorn-system --create-namespace --version $LONGHORN_VERSION $values_yaml
    echo "  Installing longhornctl binary..."
    if ! curl -fL https://github.com/longhorn/cli/releases/download/v$LONGHORN_VERSION/longhornctl-linux-amd64 -o $WORKING_DIR/ap-utilities/helm/longhorn/longhornctl; then
      echo "Error: failed to download longhornctl v$LONGHORN_VERSION."
      rm -f $WORKING_DIR/ap-utilities/helm/longhorn/longhornctl
      exit 1
    fi
    # install (copy), not mv: keeps the cached copy so re-runs stay idempotent
    install -m 0755 $WORKING_DIR/ap-utilities/helm/longhorn/longhornctl /usr/local/bin/longhornctl
    state_set AP_INSTALLED_LONGHORNCTL "/usr/local/bin/longhornctl"
  else
    /usr/local/bin/helm upgrade --install longhorn $WORKING_DIR/ap-utilities/helm/longhorn/longhorn-$LONGHORN_VERSION.tgz --namespace longhorn-system --create-namespace $values_yaml
    echo "  Installing longhornctl binary..."
    install -m 0755 $WORKING_DIR/ap-utilities/helm/longhorn/longhornctl /usr/local/bin/longhornctl
    state_set AP_INSTALLED_LONGHORNCTL "/usr/local/bin/longhornctl"
  fi
  check_namespace_pods_ready "longhorn-system"
  verify_longhorn_csi_registration
  if [[ -n $LONGHORN_UI_PORT ]]; then
    cat << EOF > $WORKING_DIR/ap-utilities/helm/longhorn/longhornNodePort.yaml
