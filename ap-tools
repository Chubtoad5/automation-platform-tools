download_dell_bundle () {
  # $1 = URL (or a bare filename already placed in $WORKING_DIR), $2 = destination file,
  # $3 = label for messages. Shared by the DAP and DDPC bundles.
  # AP-4: wget is absent on minimal images; use curl (-fL) and download to a .partial
  # file so an interrupted multi-GB fetch never masquerades as a complete bundle. A
  # leftover .partial is resumed with 'curl -C -' before falling back to a fresh fetch.
  local url="$1" dest="$2" label="$3"
  if [[ -f "$dest" ]]; then
    echo "  $label bundle already downloaded."
    return 0
  fi
  if [[ $AIR_GAPPED_MODE == "1" ]]; then
    echo "Error: air-gapped mode, but $(basename "$dest") is not present in $WORKING_DIR."
    echo "  Re-run 'offline-prep' on a connected host with the matching DOWNLOAD_*_BUNDLE=true, or copy the zip into $WORKING_DIR."
    exit 1
  fi
  local user_agent_string="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3"
  local url_host
  url_host=$(echo "$url" | cut -d "/" -f3)
  local curl_opts=(-fkL --retry 3)
  if [[ "$url_host" == "dl.dell.com" ]]; then
    curl_opts+=(--user-agent "$user_agent_string")
  fi
  echo "  Downloading $label bundle..."
  local dl_ok=0
  if [[ -f "$dest.partial" ]]; then
    echo "  Partial download found; attempting to resume..."
    if curl "${curl_opts[@]}" -C - -o "$dest.partial" "$url"; then
      dl_ok=1
    else
      echo "  Resume failed; restarting the download from scratch..."
      rm -f "$dest.partial"
    fi
  fi
  if [[ $dl_ok -eq 0 ]]; then
    if ! curl "${curl_opts[@]}" -o "$dest.partial" "$url"; then
      rm -f "$dest.partial"
      echo "Error: Failed to download the $label bundle. Verify URL $url is correct and internet connection is available."
      echo "  Alternatively, download the bundle manually, place it in $WORKING_DIR and set the *_BUNDLE_URL variable to the zip file name, then try again."
      exit 1
    fi
  fi
  mv "$dest.partial" "$dest"
}

download_ap_bundle () {
  download_dell_bundle "$AP_BUNDLE_URL" "$WORKING_DIR/$bundle_file" "Dell Automation Platform"
}

download_ddpc_bundle () {
  download_dell_bundle "$DDPC_BUNDLE_URL" "$WORKING_DIR/$ddpc_bundle_file" "Dell Distributed Private Cloud"
}

generate_images_file () {
  # AP-17: regenerate ap-tools' OWN add-on image list from scratch every run ('>' with
  # dedup, never '>>' growth). rke2-installer now also regenerates its
  # utility-images.txt from scratch, so appending into rke2's list (the old approach)
  # would be wiped - the add-on images (HAProxy, Longhorn, MetalLB) are saved, pushed,
  # and staged by ap-tools itself via image_pull_push.sh.
  local list_dir="$WORKING_DIR/ap-utilities/images"
  local addon_list="$list_dir/ap-addon-images.txt"
  echo "  Generating add-on image list (HAProxy, Longhorn, MetalLB)..."
  # Haproxy images
  echo "haproxytech/kubernetes-ingress:$HAPROXY_APP_VERSION" > $list_dir/ap-addon-images.tmp
  # Longhorn images
  if ! curl -sfL https://github.com/longhorn/longhorn/releases/download/v$LONGHORN_VERSION/longhorn-images.txt -o $WORKING_DIR/ap-utilities/helm/longhorn/longhorn-images.txt; then
    echo "Error: failed to download longhorn-images.txt for v$LONGHORN_VERSION."
    rm -f $list_dir/ap-addon-images.tmp
    exit 1
  fi
  cat $WORKING_DIR/ap-utilities/helm/longhorn/longhorn-images.txt >> $list_dir/ap-addon-images.tmp
  # Metallb images
  if ! curl -sfL https://raw.githubusercontent.com/metallb/metallb/v$METALLB_VERSION/config/manifests/metallb-frr.yaml -o $WORKING_DIR/ap-utilities/helm/metallb/metallb-frr.yaml; then
    echo "Error: failed to download the metallb v$METALLB_VERSION manifest."
    rm -f $list_dir/ap-addon-images.tmp
    exit 1
  fi
  grep 'image:' $WORKING_DIR/ap-utilities/helm/metallb/metallb-frr.yaml | awk '{print $2}' >> $list_dir/ap-addon-images.tmp
  sort -u $list_dir/ap-addon-images.tmp > "$addon_list"
  rm -f $list_dir/ap-addon-images.tmp
}

save_addon_images () {
  # Save the add-on images into ap-tools' own archive under ap-utilities/images/.
  # Older archives are removed first so re-runs regenerate instead of accumulating.
  image_pull_push_check
  cd $WORKING_DIR/ap-utilities/images
  rm -f container_images_*.tar.gz
  ./image_pull_push.sh -f ap-addon-images.txt save
  cd $base_dir
}

push_addon_images () {
  # Push the HAProxy/Longhorn/MetalLB images ap-tools deploys itself. rke2_installer's
  # push covers only its own regenerated utility list, so ap-tools pushes its add-ons.
  echo "  Pushing HAProxy/Longhorn/MetalLB add-on images to $REGISTRY_INFO..."
  cd $WORKING_DIR/ap-utilities/images
  if [[ $AIR_GAPPED_MODE == "1" ]]; then
    local archive=""
    archive=$(ls -1t container_images_*.tar.gz 2>/dev/null | head -n 1) || true
    if [[ -z "$archive" ]]; then
      echo "  WARNING: no add-on image archive found in ap-utilities/images."
      echo "  (Archives built by older ap-tools carried the add-on images inside rke2's own"
      echo "   utility archive, which rke2_installer.sh already pushed - continuing.)"
      cd $base_dir
      return 0
    fi
    ./image_pull_push.sh -f "$archive" push $REGISTRY_INFO $REG_USER $REG_PASS
  else
    image_pull_push_check
    generate_images_file
    ./image_pull_push.sh -f ap-addon-images.txt push $REGISTRY_INFO $REG_USER $REG_PASS
  fi
  cd $base_dir
}

stage_addon_images () {
  # Air-gapped 'install rke2'/'join' WITHOUT a private registry: containerd must find
  # the add-on images locally. Stage them into RKE2's agent image dir BEFORE the rke2
  # service first starts (containerd auto-imports every archive in that dir).
  local rke2_data_path="$RKE2_DATA"
  [[ "$rke2_data_path" == "default" ]] && rke2_data_path="/var/lib/rancher/rke2"
  local archive=""
  archive=$(ls -1t $WORKING_DIR/ap-utilities/images/container_images_*.tar.gz 2>/dev/null | head -n 1) || true
  if [[ -z "$archive" ]]; then
    echo "  WARNING: no add-on image archive found in ap-utilities/images."
    echo "  (Archives built by older ap-tools carried the add-on images inside rke2's own"
    echo "   utility archive, which rke2_installer.sh already stages - continuing.)"
    return 0
  fi
  echo "  Staging add-on images (HAProxy, Longhorn, MetalLB) for containerd import..."
  rm -rf $WORKING_DIR/ap-utilities/images/extract
  mkdir -p $WORKING_DIR/ap-utilities/images/extract "$rke2_data_path/agent/images"
  tar -xzf "$archive" -C $WORKING_DIR/ap-utilities/images/extract
  cp $WORKING_DIR/ap-utilities/images/extract/images/images.tar.gz "$rke2_data_path/agent/images/ap-addon-images.tar.gz"
  rm -rf $WORKING_DIR/ap-utilities/images/extract
}

