# (reboot, rke2-server restart, drain/uncordon) the longhorn-csi-plugin pod can show Running while
# its CSINode entry stays empty ("no drivers registered"), which fails all volume attach with
# "CSINode <node> does not contain driver driver.longhorn.io". Bounce the plugin daemonset to fix.
verify_longhorn_csi_registration () {
  echo "  Verifying Longhorn CSI driver registration on all nodes..."
  local timeout=120 interval=10 elapsed=0 all_registered
  while [ $elapsed -lt $timeout ]; do
    all_registered=true
    for node in $(kubectl get nodes --no-headers -o custom-columns=NAME:.metadata.name); do
      local drivers
      drivers=$(kubectl get csinode "$node" -o jsonpath='{.spec.drivers[*].name}' 2>/dev/null || echo "")
      if ! echo "$drivers" | grep -q "driver.longhorn.io"; then
        echo "  - $node: CSI driver not yet registered, waiting..."
        all_registered=false
      fi
    done
    if $all_registered; then
      echo "  Longhorn CSI driver registered on all nodes."
      return 0
    fi
    sleep $interval
    elapsed=$((elapsed + interval))
  done
  echo "  WARNING: CSI driver registration timed out. Restarting longhorn-csi-plugin pods..."
  kubectl rollout restart daemonset/longhorn-csi-plugin -n longhorn-system
  kubectl rollout status daemonset/longhorn-csi-plugin -n longhorn-system --timeout=120s || true
  echo "  longhorn-csi-plugin restarted. Verify CSI registration with:"
  echo "    kubectl get csinode -o custom-columns=NODE:.metadata.name,DRIVERS:.spec.drivers[*].name"
}

helm_install_metallb () {
  local pool_ip="$LB_IP"   # LB_IP already folds in the deprecated LB_VIP alias (see top of script)
  cat << EOF > $WORKING_DIR/ap-utilities/helm/metallb/metallb-config.yaml
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: default-ip-pool
  namespace: metallb-system
spec:
  addresses:
    - $pool_ip/32
  autoAssign: true
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: l2-advertisement
  namespace: metallb-system
spec:
  ipAddressPools:
    - default-ip-pool
  interfaces:
    - $mgmt_if
EOF
  # AP-1: 'upgrade --install' converges on re-runs instead of failing on an existing release
  if [[ $AIR_GAPPED_MODE == "0" ]]; then
    /usr/local/bin/helm upgrade --install metallb metallb/metallb --namespace metallb-system --create-namespace --version $METALLB_VERSION
  else
    /usr/local/bin/helm upgrade --install metallb $WORKING_DIR/ap-utilities/helm/metallb/metallb-$METALLB_VERSION.tgz --namespace metallb-system --create-namespace
  fi
  check_namespace_pods_ready "metallb-system"
  kubectl apply -f $WORKING_DIR/ap-utilities/helm/metallb/metallb-config.yaml
}

# --- Automation Platform Bundle prep defenitions --- #

ap_bundle_prep () {
  if [[ $INSTALL_TYPE == "ap-bundle" ]]; then
    ap_host_config
    install_reg_docker
    extract_ap_bundle
  fi
}

reg_ca_checksum () {
  # md5 of the registry CA currently in the system trust store, or 'absent'
  local p
  for p in "/usr/local/share/ca-certificates/$REG_FQDN.crt" "/etc/pki/ca-trust/source/anchors/$REG_FQDN.crt" "/etc/pki/trust/anchors/$REG_FQDN.crt"; do
    if [[ -f "$p" ]]; then
      md5sum "$p" | awk '{print $1}'
      return 0
    fi
  done
  echo "absent"
}

install_reg_docker () {
  echo "  Running checks for Registry Certificate and Docker engine..."
  image_pull_push_check
  cp $WORKING_DIR/ap-utilities/images/image_pull_push.sh $WORKING_DIR/rke2/rke2-install/rke2-utilities
  cd $WORKING_DIR/rke2/rke2-install/rke2-utilities
  local docker_preexisted="false"
  command -v docker >/dev/null 2>&1 && docker_preexisted="true"
  state_record_once AP_DOCKER_PREEXISTED "$docker_preexisted"
  # AP-10: capture the registry CA state around reg-cert so services are only bounced
  # when the certificate actually changed (ap-bundle re-runs no longer restart docker
  # and the whole control plane every time).
  local cert_before cert_after
  cert_before=$(reg_ca_checksum)
  ./image_pull_push.sh reg-cert $REGISTRY_INFO
  cert_after=$(reg_ca_checksum)
  state_set AP_REG_FQDN "$REG_FQDN"
  state_set AP_REG_CERTSD_DIR "/etc/docker/certs.d/$REGISTRY_INFO"
  if [[ $AIR_GAPPED_MODE == "0" ]]; then
    ./image_pull_push.sh docker
  else
    # AP-6: the old quoted glob never expanded, so the air-gapped docker install ALWAYS
    # failed here. Expand properly and load every archive oldest -> newest (newest tags
    # win on overlap); images-pull-push save archives are timestamped.
    local docker_archives=()
    while IFS= read -r file; do docker_archives+=("$file"); done \
      < <(ls -1tr $WORKING_DIR/rke2/rke2-install/rke2-utilities/container_images_*.tar.gz 2>/dev/null || true)
    if [[ ${#docker_archives[@]} -eq 0 ]]; then
      echo "Error: no container_images_*.tar.gz archive found in rke2-install/rke2-utilities."
      echo "  The air-gapped bundle is incomplete - re-run 'offline-prep' on a connected host."
      exit 1
    fi
    local file
    for file in "${docker_archives[@]}"; do
      ./image_pull_push.sh docker -f "$file"
    done
  fi
  if [[ "$cert_before" != "$cert_after" ]] || ! systemctl is-active --quiet docker; then
    echo "  restarting docker service..."
    systemctl restart docker
  else
    echo "  Registry certificate unchanged and docker is running - skipping docker restart."
  fi
  if [[ "$cert_before" != "$cert_after" ]]; then
    if systemctl is-active --quiet rke2-server.service; then
      echo "  restarting rke2-server.service..."
      systemctl restart rke2-server.service
    fi
  else
    echo "  Registry certificate unchanged - skipping rke2-server restart."
  fi
  cd $base_dir
}

resolve_reg_cert_path () {
  # prints the registry CA file for <fqdn> from the system trust store, or nothing
  local fqdn="$1" p
  for p in "/usr/local/share/ca-certificates/$fqdn.crt" "/etc/pki/ca-trust/source/anchors/$fqdn.crt" "/etc/pki/trust/anchors/$fqdn.crt"; do
    if [[ -f "$p" ]]; then
      echo "$p"
      return 0
    fi
  done
  echo ""
}

extract_dell_bundle () {
  # $1 = zip, $2 = extraction dir, $3 = label. Idempotent: an extracted tree (marker =
  # install-upgrade.sh) is left alone. Dell ships a signed OUTER zip wrapping the real
  # bundle zip (plus .signed.bin + dell_public.key), so a second unzip pass is needed.
  local zip="$1" dir="$2" label="$3"
  if [[ -f "$dir/install-upgrade.sh" ]]; then
    echo "  $label bundle already extracted."
    chmod +x "$dir/install-upgrade.sh"
    return 0
  fi
  if [[ ! -f "$zip" ]]; then
    echo "Error: $zip not found - nothing to extract."
    exit 1
  fi
  echo "  Extracting $label bundle, this may take several minutes..."
  mkdir -p "$dir"
  unzip -o "$zip" -d "$dir" > /dev/null 2>&1 || true
  if [[ ! -f "$dir/install-upgrade.sh" ]]; then
    local inner
    for inner in "$dir"/*.zip; do
      if [[ -f "$inner" ]]; then
        unzip -o "$inner" -d "$dir" > /dev/null 2>&1 || true
        rm -f "$inner"
      fi
    done
  fi
  if [[ ! -f "$dir/install-upgrade.sh" ]]; then
    echo "Error: install-upgrade.sh not found after extracting the bundle. The downloaded"
    echo "  zip may be corrupt or not a $label bundle - remove $zip and re-run."
    exit 1
  fi
  chmod +x "$dir/install-upgrade.sh"
}

extract_ap_bundle () {
  if [[ ! -f "$WORKING_DIR/bundle/install-upgrade.sh" ]]; then
    echo "  Checking for Automation Platform Bundle and downloading if needed. This may take several minutes..."
    run_debug download_ap_bundle
  fi
  extract_dell_bundle "$WORKING_DIR/$bundle_file" "$WORKING_DIR/bundle" "Dell Automation Platform"
  REG_CERT_FILE_PATH=$(resolve_reg_cert_path "$REG_FQDN")
  if [[ -z "$REG_CERT_FILE_PATH" ]]; then
    echo "Error: registry certificate not found."
    exit 1
  fi
  state_set AP_REG_CA_PATH "$REG_CERT_FILE_PATH"
}

# --- Dell Distributed Private Cloud (DDPC) add-on definitions --- #
# 'install ddpc-bundle' stages Dell's DDPC add-on bundle on top of a RUNNING DAP install
# (same cluster, same orchestrator namespace). Like 'install ap-bundle' it never runs the
# Dell installer itself: it pre-checks, downloads/extracts idempotently, and writes the
# ready-to-run install-upgrade.sh command to ddpc-install-upgrade-cmd.txt.

ddpc_kube_env () {
  export KUBECONFIG=/etc/rancher/rke2/rke2.yaml
  export PATH=$PATH:/var/lib/rancher/rke2/bin:/usr/local/bin
}

ddpc_helm_bin () {
  # prints the helm binary to use (ap-tools installs to /usr/local/bin; pre-phase2 hosts used /usr/bin)
  local h
  for h in /usr/local/bin/helm /usr/bin/helm; do
    if [[ -x "$h" ]]; then
      echo "$h"
      return 0
    fi
  done
  command -v helm 2>/dev/null || true
}

ddpc_registry_resolve () {
  # Decide which registry the DDPC images go to, and record where DAP itself pulls from.
  # Sets DDPC_REG_URL / DDPC_REG_HOST / DDPC_REG_SOURCE / DDPC_SECRET_REG_URL.
  local secret_b64 secret_url=""
  secret_b64=$(kubectl -n "$ORCHESTRATOR_NAMESPACE" get secret docker-secret -o jsonpath='{.data.\.dockerconfigjson}' 2>/dev/null || true)
  if [[ -n "$secret_b64" ]]; then
    secret_url=$(echo "$secret_b64" | base64 -d 2>/dev/null | jq -r '.auths | keys[0] // empty' 2>/dev/null || true)
    secret_url="${secret_url#*//}"
    secret_url="${secret_url%/}"
  fi
  DDPC_SECRET_REG_URL="$secret_url"
  if [[ $REGISTRY_MODE == "1" ]]; then
    DDPC_REG_URL="$REGISTRY_INFO/$REGISTRY_PROJECT_NAME"
    DDPC_REG_SOURCE="-registry"
    if [[ -n "$secret_url" && "$secret_url" != "$DDPC_REG_URL" ]]; then
      echo "  WARNING: -registry points at $DDPC_REG_URL but the orchestrator's docker-secret pulls from $secret_url."
      echo "  DDPC images will be pushed to and pulled from $DDPC_REG_URL via their own pull secret; DAP keeps using $secret_url."
    fi
  else
    if [[ -z "$secret_url" ]]; then
      echo "Error: no -registry given and no docker-secret found in namespace $ORCHESTRATOR_NAMESPACE to reuse."
      echo "  Re-run with: install ddpc-bundle -registry [registry:port] [username] [password]"
      exit 1
    fi
    DDPC_REG_URL="$secret_url"
    DDPC_REG_SOURCE="docker-secret"
  fi
  DDPC_REG_HOST="${DDPC_REG_URL%%/*}"
  echo "  DDPC image registry: $DDPC_REG_URL (from $DDPC_REG_SOURCE)"
}

ddpc_registry_check () {
  # The registry must answer over TLS before the ~6GB download starts. With -registry the
  # credentials are verified too (HTTP 200 on /v2/); without, the system trust store must
  # already trust the registry CA (it does on a host that ran 'install ap-bundle').
  echo "  Running pre-flight registry check for $DDPC_REG_HOST..."
  local code
  if [[ $REGISTRY_MODE == "1" ]]; then
    code=$(curl -sk -o /dev/null -w '%{http_code}' --connect-timeout 10 -u "$REG_USER:$REG_PASS" "https://$DDPC_REG_HOST/v2/" 2>/dev/null || true)
    case "$code" in
      200) echo "  Registry $DDPC_REG_HOST reachable, credentials accepted." ;;
      401|403)
        echo "Error: registry $DDPC_REG_HOST rejected the -registry credentials (HTTP $code)."
        exit 1 ;;
      *)
        echo "Error: registry https://$DDPC_REG_HOST/v2/ is not reachable (HTTP ${code:-000}). Check the address, port and network."
        exit 1 ;;
    esac
  else
    code=$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 10 "https://$DDPC_REG_HOST/v2/" 2>/dev/null || true)
    case "$code" in
      200|401) echo "  Registry $DDPC_REG_HOST reachable and its certificate is trusted by this host." ;;
      *)
        echo "Error: registry https://$DDPC_REG_HOST/v2/ is not reachable with the system trust store (HTTP ${code:-000})."
        echo "  If the registry uses a private CA, pass -registry so ap-tools installs the CA; otherwise fix connectivity."
        exit 1 ;;
    esac
  fi
}

ddpc_resource_check () {
  # DDPC adds ~10 single-replica services plus one-shot jobs to the orchestrator namespace
  # and no PVCs. Dell's DDPC installer has no resource gate of its own, so ap-tools checks
  # HEADROOM (allocatable minus what running pods already request) rather than raw capacity:
  # a node that passed the DAP gate can still be fully committed by DAP itself.
  echo "  Running pre-flight resource headroom checks..."
  local alloc_json req_json
  alloc_json=$(kubectl get nodes -o json | jq -c "$ap_jq_qty_defs"'
    {cpu: ([.items[]?.status.allocatable.cpu | cpu_cores] | add // 0),
     mem_gb: ([.items[]?.status.allocatable.memory | qty_gb] | add // 0)}' 2>/dev/null || true)
  req_json=$(kubectl get pods -A -o json | jq -c "$ap_jq_qty_defs"'
    [.items[] | select(.status.phase != "Succeeded" and .status.phase != "Failed")
      | (.spec.containers[]?.resources.requests // {})]
    | {cpu: ([.[] | .cpu // "0" | cpu_cores] | add // 0),
       mem_gb: ([.[] | .memory // "0" | qty_gb] | add // 0)}' 2>/dev/null || true)
  if [[ -z "$alloc_json" || -z "$req_json" ]]; then
    echo "Error: could not compute the cluster resource headroom. Check kubectl connectivity and 'jq'."
    exit 1
  fi
  local cpu_free mem_free disk_free rc=0
  cpu_free=$(jq -rn --argjson a "$alloc_json" --argjson r "$req_json" '$a.cpu - $r.cpu')
  mem_free=$(jq -rn --argjson a "$alloc_json" --argjson r "$req_json" '$a.mem_gb - $r.mem_gb')
  cpu_free=$(LC_ALL=C printf '%.2f' "$cpu_free")
  mem_free=$(LC_ALL=C printf '%.1f' "$mem_free")
  if (( $(echo "$cpu_free < $DDPC_REQUIRED_CPU_HEADROOM" | bc -l) )); then
    echo "Error: not enough unrequested CPU for DDPC. Required headroom: $DDPC_REQUIRED_CPU_HEADROOM cores, available: $cpu_free"
    rc=1
  fi
  if (( $(echo "$mem_free < $DDPC_REQUIRED_MEM_HEADROOM_GB" | bc -l) )); then
    echo "Error: not enough unrequested memory for DDPC. Required headroom: $DDPC_REQUIRED_MEM_HEADROOM_GB GB, available: $mem_free GB"
    rc=1
  fi
  disk_free=$(df -BG --output=avail "$WORKING_DIR" 2>/dev/null | awk 'NR==2 {gsub("G","",$1); print $1}')
  disk_free=${disk_free:-0}
  if (( disk_free < DDPC_REQUIRED_DISK_GB )); then
    echo "Error: not enough free disk under $WORKING_DIR for the DDPC bundle (zip + extraction + docker image load). Required: ${DDPC_REQUIRED_DISK_GB} GB, available: ${disk_free} GB"
    rc=1
  fi
  if [[ $rc -eq 0 ]]; then
    echo "🎉 Cluster headroom check PASSED."
    echo "  CPU headroom: $cpu_free cores (allocatable minus requested)"
    echo "  Memory headroom: $mem_free GB"
    echo "  Free disk under $WORKING_DIR: ${disk_free} GB"
  else
    echo "🛑 Cluster headroom check FAILED. Exiting."
    echo "  (Gates: DDPC_REQUIRED_CPU_HEADROOM / DDPC_REQUIRED_MEM_HEADROOM_GB / DDPC_REQUIRED_DISK_GB.)"
    exit 1
  fi
}

ddpc_preflight_checks () {
  ddpc_kube_env
  echo "  Running DDPC pre-flight checks (cluster, DAP orchestrator, registry, headroom, NTP)..."
  local fail=0 helm_bin ns
  # 1. Kubernetes reachable and every node Ready
  if ! kubectl get nodes >/dev/null 2>&1; then
    echo "Error: Kubernetes API not reachable (KUBECONFIG=$KUBECONFIG)."
    echo "  DDPC installs INTO an existing DAP cluster: run 'install rke2', 'install ap-bundle' and the DAP install first."
    exit 1
  fi
  local not_ready
  not_ready=$(kubectl get nodes --no-headers 2>/dev/null | awk '$2 != "Ready" {print $1}' | xargs)
  if [[ -n "$not_ready" ]]; then
    echo "Error: cluster node(s) not Ready: $not_ready"
    fail=1
  else
    echo "  Cluster healthy: $(kubectl get nodes --no-headers | wc -l) node(s) Ready."
  fi
  helm_bin=$(ddpc_helm_bin)
  if [[ -z "$helm_bin" ]]; then
    echo "Error: helm not found - the DDPC installer needs helm (installed by 'install rke2')."
    exit 1
  fi
  # 2. DAP installed, deployed, and at the version this DDPC bundle requires
  for ns in "$ORCHESTRATOR_NAMESPACE" "$PORTAL_NAMESPACE"; do
    if ! kubectl get namespace "$ns" >/dev/null 2>&1; then
      echo "Error: namespace $ns not found - Dell Automation Platform is not installed on this cluster."
      fail=1
    fi
  done
  local dap_rel dap_status portal_status
  dap_rel=$($helm_bin ls -n "$ORCHESTRATOR_NAMESPACE" -o json 2>/dev/null | jq -c '[.[] | select(.chart | startswith("native-edge-orchestrator"))] | first // empty' 2>/dev/null || true)
  if [[ -z "$dap_rel" ]]; then
    echo "Error: no native-edge-orchestrator helm release in namespace $ORCHESTRATOR_NAMESPACE."
    echo "  Run the DAP install (the install-upgrade.sh command from 'install ap-bundle') before adding DDPC."
    fail=1
  else
    dap_status=$(jq -r '.status' <<< "$dap_rel")
    DDPC_DAP_VERSION=$(jq -r '.app_version' <<< "$dap_rel")
    if [[ "$dap_status" != "deployed" ]]; then
      echo "Error: the DAP orchestrator helm release is '$dap_status', expected 'deployed'. Fix the DAP install before adding DDPC."
      fail=1
    fi
    if [[ "$DDPC_REQUIRED_DAP_VERSION" != "any" && "$DDPC_DAP_VERSION" != "$DDPC_REQUIRED_DAP_VERSION" ]]; then
      echo "Error: DAP orchestrator version is $DDPC_DAP_VERSION but this DDPC bundle requires $DDPC_REQUIRED_DAP_VERSION."
      echo "  Upgrade DAP first, or override with DDPC_REQUIRED_DAP_VERSION=<version> (or 'any') if the bundle supports it."
      fail=1
    else
      echo "  DAP orchestrator $DDPC_DAP_VERSION is deployed (required: $DDPC_REQUIRED_DAP_VERSION)."
    fi
  fi
  portal_status=$($helm_bin ls -n "$PORTAL_NAMESPACE" -o json 2>/dev/null | jq -r '[.[] | select(.chart | startswith("dap-portal"))] | first | .status // empty' 2>/dev/null || true)
  if [[ "$portal_status" != "deployed" ]]; then
    echo "Error: the DAP portal helm release in $PORTAL_NAMESPACE is '${portal_status:-missing}', expected 'deployed'."
    fail=1
  fi
  # 3. No unhealthy pods in the platform namespaces
  # A pod stuck in Terminating (typical after a node restart) is reported but does not block: its
  # replacement is what matters, and that shows up as a non-Running pod if it is unhealthy.
  local bad_pods term_pods pods_ok=1
  for ns in kube-system "$PORTAL_NAMESPACE" "$ORCHESTRATOR_NAMESPACE"; do
    bad_pods=$(kubectl get pods -n "$ns" --no-headers 2>/dev/null | awk '$3 !~ /^(Running|Completed|Terminating)$/ {print $1" ("$3")"}' | xargs)
    term_pods=$(kubectl get pods -n "$ns" --no-headers 2>/dev/null | awk '$3 == "Terminating" {print $1}' | xargs)
    if [[ -n "$bad_pods" ]]; then
      echo "Error: unhealthy pod(s) in $ns: $bad_pods"
      fail=1
      pods_ok=0
    fi
    if [[ -n "$term_pods" ]]; then
      echo "  WARNING: pod(s) stuck Terminating in $ns (not blocking; force-delete them if they never go away): $term_pods"
    fi
  done
  [[ $pods_ok -eq 1 ]] && echo "  All pods Running/Completed in kube-system, $PORTAL_NAMESPACE and $ORCHESTRATOR_NAMESPACE."
  # 4. The orchestrator FQDN handed to DDPC (DAPO_HOST) must be the one DAP actually serves
  local ingress_hosts
  ingress_hosts=$(kubectl -n "$ORCHESTRATOR_NAMESPACE" get ingress -o jsonpath='{.items[*].spec.rules[*].host}' 2>/dev/null || true)
  if [[ " $ingress_hosts " != *" $ORCHESTRATOR_FQDN "* ]]; then
    echo "Error: ORCHESTRATOR_FQDN '$ORCHESTRATOR_FQDN' is not served by any ingress in $ORCHESTRATOR_NAMESPACE (hosts: ${ingress_hosts:-none})."
    echo "  Set HOST_FQDN / ORCHESTRATOR_FQDN to the values used at 'install ap-bundle' (multi-node: HOST_FQDN=<cluster-name>)."
    fail=1
  else
    echo "  Orchestrator ingress serves $ORCHESTRATOR_FQDN."
  fi
  # 5. An existing DDPC release is fine (re-runs); leftover eo-chart NE services are not
  DDPC_EXISTING_RELEASE=$($helm_bin ls -n "$ORCHESTRATOR_NAMESPACE" -o json 2>/dev/null | jq -r '.[] | select(.name == "dell-distributed-private-cloud") | "\(.status) \(.app_version)"' 2>/dev/null || true)
  if [[ -n "$DDPC_EXISTING_RELEASE" ]]; then
    echo "  NOTE: a DDPC release is already present ($DDPC_EXISTING_RELEASE). Re-running the generated command is safe:"
    echo "  same version -> Dell's installer skips; failed -> it retries; newer bundle -> it upgrades."
  else
    local leftover
    leftover=$(kubectl -n "$ORCHESTRATOR_NAMESPACE" get pods -l 'hzp-app in (hzp-compute-svc,hzp-ece-firmwareupdate-svc,hzp-fru-cru-svc,hzp-oe-template-mgr-svc,hzp-recovery-svc,hzp-time-svc,hzp-health-check-svc,fido-manufacturer)' --no-headers 2>/dev/null | wc -l)
    if [[ "$leftover" -gt 0 ]]; then
      echo "Error: $leftover NE-service pod(s) already run in $ORCHESTRATOR_NAMESPACE without a DDPC release (eo-chart deployNEservices=true?)."
      echo "  Dell's DDPC pre-install check refuses this state; disable the eo-chart NE services first."
      fail=1
    fi
  fi
  if [[ $fail -ne 0 ]]; then
    echo "🛑 DDPC pre-flight checks FAILED. Exiting."
    exit 1
  fi
  # 6. registry, 7. headroom, 8. NTP
  ddpc_registry_resolve
  ddpc_registry_check
  ddpc_resource_check
  ntp_preflight_check
}

ddpc_bundle_prep () {
  ddpc_kube_env
  if [[ $REGISTRY_MODE == "1" ]]; then
    # Same idempotent path as ap-bundle: trusts the registry CA and installs docker only
    # when missing; services are bounced only when the CA actually changed (AP-10).
    # install_reg_docker writes the ap-bundle-owned AP_REG_FQDN / AP_REG_CERTSD_DIR keys; when
    # DDPC targets a DIFFERENT registry those must keep pointing at DAP's, so they are
    # restored and the DDPC registry is recorded under its own keys (used by uninstall).
    local ap_reg_fqdn ap_reg_certsd
    ap_reg_fqdn=$(state_get AP_REG_FQDN)
    ap_reg_certsd=$(state_get AP_REG_CERTSD_DIR)
    install_reg_docker
    REG_CERT_FILE_PATH=$(resolve_reg_cert_path "$REG_FQDN")
    if [[ -z "$REG_CERT_FILE_PATH" ]]; then
      echo "Error: registry certificate for $REG_FQDN not found in the system trust store."
      exit 1
    fi
    state_set DDPC_REG_FQDN "$REG_FQDN"
    state_set DDPC_REG_CA_PATH "$REG_CERT_FILE_PATH"
    state_set DDPC_REG_CERTSD_DIR "/etc/docker/certs.d/$REGISTRY_INFO"
    if [[ -n "$ap_reg_fqdn" && "$ap_reg_fqdn" != "$REG_FQDN" ]]; then
      state_set AP_REG_FQDN "$ap_reg_fqdn"
      state_set AP_REG_CERTSD_DIR "$ap_reg_certsd"
    fi
  elif [[ "$DDPC_SKIP_IMAGES_LOADER" != "true" ]] && ! command -v docker >/dev/null 2>&1; then
    echo "Error: docker is required to push the DDPC images but is not installed on this host."
    echo "  Pass -registry so ap-tools installs docker and trusts the registry CA, or set DDPC_SKIP_IMAGES_LOADER=true if the images are already in $DDPC_REG_URL."
    exit 1
  fi
  if [[ ! -f "$DDPC_BUNDLE_DIR/install-upgrade.sh" ]]; then
    echo "  Checking for the DDPC bundle and downloading if needed. This may take several minutes..."
    run_debug download_ddpc_bundle
  fi
  extract_dell_bundle "$WORKING_DIR/$ddpc_bundle_file" "$DDPC_BUNDLE_DIR" "Dell Distributed Private Cloud"
  state_set DDPC_BUNDLE_DIR "$DDPC_BUNDLE_DIR"
  state_set DDPC_BUNDLE_FILE "$WORKING_DIR/$ddpc_bundle_file"
}

ap_host_config () {
  if [[ $AIR_GAPPED_MODE == "0" ]]; then
    download_support_tool
  fi
  configure_node_sysctl
  enable_iscsid
}

# Apply DAP host kernel settings (inotify limits). Must run on EVERY cluster node
# (install + join), not just the ap-bundle host, or fluentbit (DaemonSet) crashes
# on joined nodes with inotify EMFILE. Idempotent.
# Also disables multipathd, which otherwise claims Longhorn's iSCSI sd* block devices via
# device-mapper and breaks every CSI mount (exit status 32 / "Can't open blockdev").
configure_node_sysctl () {
  echo "  Configuring host kernel settings (inotify limits) for Dell Automation Platform..."
  echo -e "fs.inotify.max_user_watches = 1048576\nfs.inotify.max_user_instances = 1024" | tee /etc/sysctl.d/10-ap-orchestrator.conf
  state_set AP_SYSCTL_FILE "/etc/sysctl.d/10-ap-orchestrator.conf"
  # AP-21: the old '$?' check here was dead code under set -e
  if ! systemctl restart systemd-sysctl; then
    echo "Error: systemd-sysctl.service failed to restart."
    exit 1
  fi
  echo "  systemd-sysctl.service restarted successfully."
  # Disable multipathd and blacklist sd* so it never claims Longhorn iSCSI LUNs. The blacklist
  # is written first so the protection persists even if a package update re-enables multipathd.
  # AP-12: written as a DROP-IN under /etc/multipath/conf.d (read by multipath-tools by
  # default) instead of clobbering /etc/multipath.conf - a pre-existing site multipath.conf
  # is preserved untouched. On ap-tools nodes the OS root disk is NVMe, so excluding all
  # sd* (Longhorn iSCSI LUNs) is safe. Prior enablement is recorded for uninstall.
  echo "  Disabling multipathd to prevent Longhorn iSCSI volume mount conflicts..."
  local mp_conf_preexisted="false" mp_svc_state mp_sock_state
  [[ -f /etc/multipath.conf ]] && mp_conf_preexisted="true"
  state_record_once AP_MULTIPATH_CONF_PREEXISTED "$mp_conf_preexisted"
  mp_svc_state=$(systemctl is-enabled multipathd.service 2>/dev/null | head -n 1) || true
  [[ -z "$mp_svc_state" ]] && mp_svc_state="not-found"
  state_record_once AP_MULTIPATHD_SERVICE_WAS_ENABLED "$mp_svc_state"
  mp_sock_state=$(systemctl is-enabled multipathd.socket 2>/dev/null | head -n 1) || true
  [[ -z "$mp_sock_state" ]] && mp_sock_state="not-found"
  state_record_once AP_MULTIPATHD_SOCKET_WAS_ENABLED "$mp_sock_state"
  mkdir -p /etc/multipath/conf.d
  printf '# Written by ap-tools - do not edit (removed by: ap-tools uninstall rke2)\n# Blacklist sd* so multipathd never claims Longhorn iSCSI LUNs (device-mapper\n# claims break every CSI mount). OS root disks on ap-tools nodes are NVMe.\nblacklist {\n    devnode "^sd[a-z0-9]+"\n}\n' \
    > /etc/multipath/conf.d/99-ap-tools.conf
  state_set AP_MULTIPATH_DROPIN "/etc/multipath/conf.d/99-ap-tools.conf"
  systemctl stop multipathd.service multipathd.socket 2>/dev/null || true
  systemctl disable multipathd.service multipathd.socket 2>/dev/null || true
  systemctl mask multipathd.service multipathd.socket 2>/dev/null || true
  echo "  multipathd disabled."
}

enable_iscsid () {
  # AP-5: Ubuntu's open-iscsi debs enable iscsid automatically; the Rocky/Leap rpms do
  # NOT, so Longhorn volume attach breaks after the first reboot. Enable at boot on
  # every cluster node (install/join/ap-bundle prep). Prior state recorded for uninstall.
  if [[ $INSTALL_LOCAL_PATH_PROVISIONER != "false" ]]; then
    return 0
  fi
  local unit=""
  if systemctl list-unit-files --no-legend 2>/dev/null | grep -q '^iscsid\.service'; then
    unit="iscsid.service"
  elif systemctl list-unit-files --no-legend 2>/dev/null | grep -q '^iscsid\.socket'; then
    unit="iscsid.socket"
  fi
  if [[ -z "$unit" ]]; then
    echo "  WARNING: no iscsid unit found (is open-iscsi/iscsi-initiator-utils installed?)."
    echo "  Longhorn iSCSI volume attach will fail until iscsid is available."
    return 0
  fi
  local prior
  prior=$(systemctl is-enabled "$unit" 2>/dev/null | head -n 1) || true
  [[ -z "$prior" ]] && prior="not-found"
  state_record_once AP_ISCSID_UNIT "$unit"
  state_record_once AP_ISCSID_WAS_ENABLED "$prior"
  systemctl enable "$unit" >/dev/null 2>&1 || true
  systemctl start "$unit" >/dev/null 2>&1 || true
  echo "  iscsid enabled at boot ($unit)."
}

ensure_bundle_prereqs () {
  # AP-20: the ap-bundle path needs jq/bc (pre-flight math) and unzip (bundle extract),
  # but only 'install rke2' installed them - a standalone 'install ap-bundle' on a node
  # prepared elsewhere failed. Install them on demand.
  local missing=() c
  for c in jq bc unzip; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    return 0
  fi
  echo "  Installing missing prerequisite packages: ${missing[*]}..."
  if [[ $AIR_GAPPED_MODE == "1" ]]; then
    cd $WORKING_DIR/ap-utilities/packages
    ./install_packages.sh offline "${missing[@]}"
  else
    install_packages_check
    cd $WORKING_DIR/ap-utilities/packages
    ./install_packages.sh online "${missing[@]}"
  fi
  cd $base_dir
}

firewalld_selinux_preflight () {
  # AP-25: Rocky 9/10 and Leap 16 default to firewalld running and SELinux enforcing.
  # Surface both LOUDLY before any heavy work instead of failing mysteriously later.
  # ap-tools does not fight the sub-installers' own handling: rke2_installer.sh stops
  # and disables firewalld on cluster nodes and verifies/installs the rke2-selinux
  # policy itself; the harbor and seaweedfs installers manage their own firewall rules.
  if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld; then
    echo "  WARNING: firewalld is ACTIVE on this host."
    case "$INSTALL_TYPE" in
      rke2)
        echo "  'install rke2' delegates to rke2_installer.sh, which stops and disables firewalld on"
        echo "  cluster nodes (prior state is recorded and restored by its uninstall)."
        ;;
      harbor)
        echo "  Harbor needs inbound TCP $HARBOR_PORT (plus 80/443) reachable from clients;"
        echo "  install_harbor.sh manages its own firewall rules - verify remote access after install."
        ;;
      swfs)
        echo "  SeaweedFS needs its service ports reachable (S3 $SWFS_S3_PORT, filer $SWFS_FILER_PORT,"
        echo "  master $SWFS_MASTER_PORT, admin $SWFS_ADMIN_PORT, plus SMB/NFS when enabled);"
        echo "  install-seaweedfs manages its own firewalld rules."
        ;;
      ap-bundle|ddpc-bundle)
        echo "  DAP ingress (80/443 via HAProxy) and the registry port must be reachable from clients."
        ;;
      *)
        echo "  Cluster traffic (6443/9345, CNI, ingress 80/443) must not be blocked between nodes;"
        echo "  rke2_installer.sh disables firewalld on cluster nodes during install/join."
        ;;
    esac
  fi
  if command -v getenforce >/dev/null 2>&1 && [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]; then
    echo "  NOTE: SELinux is Enforcing. rke2_installer.sh verifies/installs the rke2-selinux policy"
    echo "  itself (and fails loudly if it cannot); ap-tools makes no SELinux changes."
  fi
}

# --- Host Config Helpers (W14/W15) --- #

run_config_hostname () {
  # 'config hostname <fqdn>': hostnamectl + marker-tagged /etc/hosts fixup. Run this
  # BEFORE 'install rke2'/'join' - the hostname is the node's identity (node object,
  # certificates, etcd membership) and must never change under a live cluster node.
  local fqdn="${CONFIG_ARGS[0]:-}"
  if [[ -z "$fqdn" || ${#CONFIG_ARGS[@]} -ne 1 ]]; then
    echo "Error: 'config hostname' requires exactly one argument. Format: config hostname <host.example.com>"
    echo "Type './$SCRIPT_NAME -h' for help."
    exit 1
  fi
  if [[ ! "$fqdn" =~ $fqdn_pattern ]]; then
    echo "Error: '$fqdn' is not a valid FQDN (lowercase letters, digits, hyphens and dots, e.g. node1.edge.lab)."
    exit 1
  fi
  if systemctl is-active --quiet rke2-server.service || systemctl is-active --quiet rke2-agent.service; then
    echo "Error: an RKE2 service is active on this host. Changing the hostname of a live cluster node"
    echo "  breaks its node identity. Run 'config hostname' BEFORE 'install rke2'/'join', or run"
    echo "  'uninstall rke2' first."
    exit 1
  fi
  local short="${fqdn%%.*}"
  echo "  Setting hostname to '$fqdn' (short: '$short')..."
  hostnamectl set-hostname "$fqdn"
  # Marker-tagged /etc/hosts entry - re-runs replace the previous ap-tools line
  sed -i '/# ap-tools hostname$/d' /etc/hosts
  if [[ "${OS_ID}" =~ ^(ubuntu|debian)$ ]] || [[ "${OS_ID_LIKE}" =~ (debian|ubuntu) ]]; then
    # Debian family resolves the local hostname via a 127.0.1.1 line
    if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
      sed -i -E "s|^127\.0\.1\.1[[:space:]].*|127.0.1.1 $fqdn $short # ap-tools hostname|" /etc/hosts
    else
      echo "127.0.1.1 $fqdn $short # ap-tools hostname" >> /etc/hosts
    fi
  else
    # Rocky/RHEL/Leap convention: map the management IP to the FQDN
    echo "$MGMT_IP $fqdn $short # ap-tools hostname" >> /etc/hosts
  fi
  echo "  /etc/hosts updated (marker-tagged; re-runs reconcile instead of duplicating)."
  echo "  hostname is now: $(hostname)"
  echo "  Note: already-open shells keep showing the old name until you log in again."
}

ip_to_int () {
  # dotted-quad -> integer (for subnet sanity checks)
  local IFS=.
  # shellcheck disable=SC2206
  local -a o=($1)
  echo $(( (o[0] << 24) | (o[1] << 16) | (o[2] << 8) | o[3] ))
}

detect_ssh_interfaces () {
  # Prints the interface(s) carrying established inbound SSH sessions (best effort)
  local locals sip ifc out=""
  locals=$(ss -tnH '( sport = :22 )' 2>/dev/null | awk '$1 == "ESTAB" {print $4}' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u) || true
  for sip in $locals; do
    ifc=$(ip -o -4 addr show 2>/dev/null | awk -v ip="$sip" '$4 ~ "^"ip"/" {print $2; exit}') || true
    [[ -n "$ifc" ]] && out="$out $ifc"
  done
  echo "$out" | tr ' ' '\n' | sort -u | xargs
}

static_ip_commit () {
  # Rocky/RHEL/Leap NetworkManager apply path: cancel the scheduled auto-revert.
  local pending=0
  if systemctl list-units --all --no-legend 'ap-tools-staticip-revert.*' 2>/dev/null | grep -q 'ap-tools-staticip-revert'; then
    pending=1
  fi
  systemctl stop ap-tools-staticip-revert.timer 2>/dev/null || true
  systemctl stop ap-tools-staticip-revert.service 2>/dev/null || true
  systemctl reset-failed ap-tools-staticip-revert.service 2>/dev/null || true
  if [[ -f $STATE_DIR/static-ip-revert.sh ]]; then
    rm -f "$STATE_DIR/static-ip-revert.sh"
    pending=1
  fi
  if [[ $pending -eq 1 ]]; then
    echo "  Static IP change committed - the scheduled auto-revert was cancelled."
  else
    echo "  Nothing to commit: no pending static-ip auto-revert found."
    echo "  (Ubuntu applies use 'netplan try', which confirms interactively and needs no commit.)"
  fi
}

run_config_static_ip () {
  # W15 (limited scope by design): GENERATE + VALIDATE by default - print exactly what
  # would be applied. APPLY only behind --apply:
  #   Ubuntu/Debian     -> netplan file + 'netplan try' (120s auto-rollback on lost SSH)
  #   Rocky/RHEL/Leap16 -> NetworkManager (nmcli) + scheduled 120s auto-revert; the
  #                        change survives only after 'config static-ip commit'.
  # Refuses to touch the SSH-carrying interface without --force-ssh-interface.
  local ip_prefix="" gateway="" dns_list="" search_domain="" ifc="" apply=0 force_ssh=0
  if [[ "${CONFIG_ARGS[0]:-}" == "commit" ]]; then
    static_ip_commit
    return 0
  fi
  local -a args=("${CONFIG_ARGS[@]}")
  local i=0
  while [[ $i -lt ${#args[@]} ]]; do
    case "${args[$i]}" in
      -ip)        ip_prefix="${args[$((i+1))]:-}"; i=$((i+2)) ;;
      -gw)        gateway="${args[$((i+1))]:-}"; i=$((i+2)) ;;
      -dns)       dns_list="${args[$((i+1))]:-}"; i=$((i+2)) ;;
      -domain)    search_domain="${args[$((i+1))]:-}"; i=$((i+2)) ;;
      -interface) ifc="${args[$((i+1))]:-}"; i=$((i+2)) ;;
      --apply)    apply=1; i=$((i+1)) ;;
      --force-ssh-interface) force_ssh=1; i=$((i+1)) ;;
      *)
        echo "Error: unknown 'config static-ip' argument '${args[$i]}'."
        echo "Format: config static-ip -ip <addr>/<prefix> -gw <gateway> -dns <srv1[,srv2]> [-domain <search>] [-interface <if>] [--apply] [--force-ssh-interface]"
        echo "        config static-ip commit"
        exit 1
        ;;
    esac
  done
  # --- Validation --- #
  if [[ -z "$ip_prefix" || -z "$gateway" || -z "$dns_list" ]]; then
    echo "Error: 'config static-ip' requires -ip <addr>/<prefix>, -gw <gateway>, and -dns <server[,server]>."
    echo "Type './$SCRIPT_NAME -h' for help."
    exit 1
  fi
  local ip_addr="${ip_prefix%%/*}" prefix="${ip_prefix##*/}"
  if [[ "$ip_prefix" != */* || ! "$ip_addr" =~ $ipv4_pattern || ! "$prefix" =~ ^[0-9]+$ || "$prefix" -lt 1 || "$prefix" -gt 32 ]]; then
    echo "Error: '-ip' must be <IPv4>/<prefix 1-32>, e.g. 192.168.1.50/24."
    exit 1
  fi
  if [[ ! "$gateway" =~ $ipv4_pattern ]]; then
    echo "Error: '-gw' must be a valid IPv4 address."
    exit 1
  fi
  local dns_clean dns_entry
  dns_clean=$(echo "$dns_list" | tr ',' ' ' | xargs)
  for dns_entry in $dns_clean; do
    if [[ ! "$dns_entry" =~ $ipv4_pattern ]]; then
      echo "Error: '-dns' entry '$dns_entry' is not a valid IPv4 address."
      exit 1
    fi
  done
  if [[ -n "$search_domain" && ! "$search_domain" =~ $fqdn_pattern ]]; then
    echo "Error: '-domain' must be a valid domain name, e.g. edge.lab."
    exit 1
  fi
  if [[ -z "$ifc" ]]; then
    ifc="$mgmt_if"
    echo "  No -interface given; using the management interface: $ifc"
  fi
  if [[ -z "$ifc" ]] || ! ip link show dev "$ifc" >/dev/null 2>&1; then
    echo "Error: interface '${ifc:-<none detected>}' not found on this host. Pass -interface <name>."
    exit 1
  fi
  # Subnet sanity: warn (not fail) when the gateway is outside the address's subnet
  if [[ "$prefix" -le 30 ]]; then
    local mask=$(( 0xffffffff ^ ((1 << (32 - prefix)) - 1) ))
    if (( ($(ip_to_int "$ip_addr") & mask) != ($(ip_to_int "$gateway") & mask) )); then
      echo "  WARNING: gateway $gateway is not inside $ip_prefix - double-check before applying."
    fi
  fi
  # SSH-interface guard
  local ssh_ifaces
  ssh_ifaces=$(detect_ssh_interfaces)
  if [[ " $ssh_ifaces " == *" $ifc "* && $force_ssh -eq 0 ]]; then
    if [[ $apply -eq 1 ]]; then
      echo "Error: interface '$ifc' carries your current SSH session(s). Changing it can cut you off."
      echo "  Re-run with --force-ssh-interface to proceed anyway (the 120s auto-rollback is the safety net)."
      exit 1
    else
      echo "  NOTE: interface '$ifc' carries your current SSH session(s); applying will require --force-ssh-interface."
    fi
  fi
  local dns_csv
  dns_csv=$(echo "$dns_clean" | tr ' ' ',')
  # --- Render --- #
  if [[ "${OS_ID}" =~ ^(ubuntu|debian)$ ]] || [[ "${OS_ID_LIKE}" =~ (debian|ubuntu) ]]; then
    local np_file="/etc/netplan/99-ap-tools-static.yaml"
    local np_yaml
    np_yaml="network:
  version: 2
  ethernets:
    $ifc:
      dhcp4: false
      addresses:
        - $ip_prefix
      routes:
        - to: default
          via: $gateway
      nameservers:
        addresses: [$dns_csv]"
    if [[ -n "$search_domain" ]]; then
      np_yaml="$np_yaml
        search: [$search_domain]"
    fi
    echo ""
    echo "--- netplan configuration that would be written to $np_file ---"
    echo "$np_yaml"
    echo "----------------------------------------------------------------"
    if [[ $apply -eq 0 ]]; then
      echo "  Generate-only mode: nothing was changed. Re-run with --apply to write the file and"
      echo "  activate it via 'netplan try' (interactive confirm, auto-rollback after 120s)."
      return 0
    fi
    echo "  Applying via netplan..."
    ( umask 077; echo "$np_yaml" > "$np_file" )
    if ! netplan generate; then
      echo "Error: 'netplan generate' rejected the configuration; removing $np_file."
      rm -f "$np_file"
      exit 1
    fi
    echo "  Running 'netplan try' with a 120s timeout: confirm at the prompt to keep the new"
    echo "  configuration. If the session is cut off, netplan auto-reverts after 120s."
    if ! netplan try --timeout 120; then
      echo "Error: 'netplan try' was not confirmed (or failed) - the previous configuration was restored."
      rm -f "$np_file"
      exit 1
    fi
    echo "  Static IP applied and confirmed: $ip_prefix on $ifc (gw $gateway, dns $dns_csv)."
  else
    # Rocky/RHEL/Leap 16: NetworkManager
    if ! command -v nmcli >/dev/null 2>&1; then
      echo "Error: nmcli not found - the static-ip helper requires NetworkManager on this OS family."
      exit 1
    fi
    local con
    con=$(nmcli -g GENERAL.CONNECTION device show "$ifc" 2>/dev/null | head -n 1) || true
    if [[ -z "$con" || "$con" == "--" ]]; then
      echo "Error: no active NetworkManager connection found on '$ifc'."
      exit 1
    fi
    local mod_cmd="nmcli con mod \"$con\" ipv4.method manual ipv4.addresses $ip_prefix ipv4.gateway $gateway ipv4.dns \"$dns_csv\""
    if [[ -n "$search_domain" ]]; then
      mod_cmd="$mod_cmd ipv4.dns-search \"$search_domain\""
    fi
    echo ""
    echo "--- nmcli commands that would be applied (connection: '$con', device: $ifc) ---"
    echo "$mod_cmd"
    echo "nmcli con up \"$con\""
    echo "--------------------------------------------------------------------------------"
    if [[ $apply -eq 0 ]]; then
      echo "  Generate-only mode: nothing was changed. Re-run with --apply to apply with a scheduled"
      echo "  120s auto-revert; then confirm with: $SCRIPT_NAME config static-ip commit"
      return 0
    fi
    echo "  Applying via NetworkManager with a scheduled 120s auto-revert..."
    # Snapshot current settings into a revert script BEFORE changing anything
    local cur_method cur_addrs cur_gw cur_dns cur_search
    cur_method=$(nmcli -g ipv4.method con show "$con" 2>/dev/null | head -n 1) || true
    cur_addrs=$(nmcli -g ipv4.addresses con show "$con" 2>/dev/null | head -n 1) || true
    cur_gw=$(nmcli -g ipv4.gateway con show "$con" 2>/dev/null | head -n 1) || true
    cur_dns=$(nmcli -g ipv4.dns con show "$con" 2>/dev/null | head -n 1) || true
    cur_search=$(nmcli -g ipv4.dns-search con show "$con" 2>/dev/null | head -n 1) || true
    mkdir -p "$STATE_DIR"
    cat > "$STATE_DIR/static-ip-revert.sh" << REVERT
#!/bin/bash
# Auto-generated by ap-tools 'config static-ip --apply' - restores the previous
# NetworkManager settings unless 'ap-tools config static-ip commit' cancels it.
nmcli con mod "$con" ipv4.method "${cur_method:-auto}" ipv4.addresses "${cur_addrs}" ipv4.gateway "${cur_gw}" ipv4.dns "${cur_dns}" ipv4.dns-search "${cur_search}"
nmcli con up "$con"
rm -f "$STATE_DIR/static-ip-revert.sh"
REVERT
    chmod 700 "$STATE_DIR/static-ip-revert.sh"
    systemctl stop ap-tools-staticip-revert.timer 2>/dev/null || true
    systemctl reset-failed ap-tools-staticip-revert.service 2>/dev/null || true
    if ! systemd-run --unit=ap-tools-staticip-revert --on-active=120 \
         --description="ap-tools static-ip auto-revert" /bin/bash "$STATE_DIR/static-ip-revert.sh"; then
      echo "Error: could not schedule the auto-revert timer; refusing to apply without a safety net."
      rm -f "$STATE_DIR/static-ip-revert.sh"
      exit 1
    fi
    eval "$mod_cmd"
    nmcli con up "$con" || true
    echo ""
    echo "  Applied: $ip_prefix on $ifc (gw $gateway, dns $dns_csv) via connection '$con'."
    echo "  An auto-revert to the previous settings fires in 120 seconds unless you confirm with:"
    echo "    sudo ./$SCRIPT_NAME config static-ip commit"
  fi
}

# --- Uninstall Definitions (W5) --- #

confirm_destructive () {
  # Typed-confirmation gate for destructive uninstalls. First argument is the headline,
  # remaining arguments are printed as detail lines. AP_ASSUME_YES=true skips the
  # prompt for automation.
  echo ""
  echo "WARNING: $1"
  shift
  local line
  for line in "$@"; do
    echo "  $line"
  done
  if [[ "${AP_ASSUME_YES,,}" == "true" ]]; then
    echo "  AP_ASSUME_YES=true - proceeding without interactive confirmation."
    return 0
  fi
  printf "  Type 'yes-destroy' to continue (anything else aborts): "
  local reply=""
  if ! read -r reply; then
    reply=""
  fi
  if [[ "$reply" != "yes-destroy" ]]; then
    echo "  Aborted - nothing was changed."
    exit 1
  fi
}

remove_ap_host_changes () {
  # Reverts ONLY what ap-tools itself changed on this host, using state.env records.
  # rke2_installer.sh's uninstall restores its own recorded host state (swap, firewalls,
  # its NTP config, its multipathd records) - no double handling here.
  echo "  Reverting ap-tools host changes recorded in $STATE_FILE..."
  local bin
  for bin in "$(state_get AP_INSTALLED_HELM)" "$(state_get AP_INSTALLED_K9S)" "$(state_get AP_INSTALLED_LONGHORNCTL)"; do
    if [[ -n "$bin" && -f "$bin" ]]; then
      echo "  Removing $bin"
      rm -f "$bin"
    fi
  done
  state_unset AP_INSTALLED_HELM
  state_unset AP_INSTALLED_K9S
  state_unset AP_INSTALLED_LONGHORNCTL
  # Sysctl file (fall back to the well-known name for pre-state-file installs)
  local sysctl_file
  sysctl_file=$(state_get AP_SYSCTL_FILE)
  [[ -z "$sysctl_file" ]] && sysctl_file="/etc/sysctl.d/10-ap-orchestrator.conf"
  if [[ -f "$sysctl_file" ]]; then
    echo "  Removing $sysctl_file"
    rm -f "$sysctl_file"
    systemctl restart systemd-sysctl 2>/dev/null || true
  fi
  state_unset AP_SYSCTL_FILE
  # multipath drop-in + multipathd restoration. A pre-existing site /etc/multipath.conf
  # is never touched (AP-12); a legacy ap-tools-written /etc/multipath.conf (pre drop-in
  # versions) is also left in place - it is only a harmless sd* blacklist.
  rm -f /etc/multipath/conf.d/99-ap-tools.conf
  state_unset AP_MULTIPATH_DROPIN
  systemctl unmask multipathd.service multipathd.socket 2>/dev/null || true
  if [[ "$(state_get AP_MULTIPATHD_SERVICE_WAS_ENABLED)" == "enabled" ]]; then
    echo "  Restoring multipathd.service (was enabled before install)..."
    systemctl enable --now multipathd.service 2>/dev/null || true
  fi
  if [[ "$(state_get AP_MULTIPATHD_SOCKET_WAS_ENABLED)" == "enabled" ]]; then
    systemctl enable --now multipathd.socket 2>/dev/null || true
  fi
  state_unset AP_MULTIPATHD_SERVICE_WAS_ENABLED
  state_unset AP_MULTIPATHD_SOCKET_WAS_ENABLED
  state_unset AP_MULTIPATH_CONF_PREEXISTED
  # iscsid: disable again only if ap-tools enabled it (recorded prior state != enabled)
  local iscsid_unit iscsid_prior
  iscsid_unit=$(state_get AP_ISCSID_UNIT)
  iscsid_prior=$(state_get AP_ISCSID_WAS_ENABLED)
  if [[ -n "$iscsid_unit" && -n "$iscsid_prior" && "$iscsid_prior" != "enabled" ]]; then
    echo "  Restoring iscsid ($iscsid_unit) to its pre-install state ($iscsid_prior)..."
    systemctl disable "$iscsid_unit" 2>/dev/null || true
  fi
  state_unset AP_ISCSID_UNIT
  state_unset AP_ISCSID_WAS_ENABLED
  # NTP: only when ap-tools' own configure_node_ntp did the configuring (rke2-managed
  # NTP is reverted by rke2_installer.sh uninstall via its own state records)
  local ntp_mode
  ntp_mode=$(state_get AP_NTP_CONFIGURED)
  if [[ "$ntp_mode" == "timesyncd" ]]; then
    echo "  Removing ap-tools timesyncd NTP drop-in..."
    rm -f /etc/systemd/timesyncd.conf.d/10-ap-tools.conf
    systemctl restart systemd-timesyncd 2>/dev/null || true
  elif [[ "$ntp_mode" == "chrony" ]]; then
    echo "  Removing ap-tools chrony NTP entries..."
    sed -i '/# ap-tools NTP$/d' /etc/chrony/chrony.conf 2>/dev/null || true
    sed -i '/# ap-tools NTP$/d' /etc/chrony.conf 2>/dev/null || true
    systemctl restart chronyd 2>/dev/null || systemctl restart chrony 2>/dev/null || true
  fi
  state_unset AP_NTP_CONFIGURED
  state_unset AP_DOCKER_PREEXISTED
}

