#!/bin/bash

# --- OPTIONAL INPUTS FILE (inputs.env) --- #
# If an inputs file exists it is sourced BEFORE the defaults below. The file itself
# uses the same 'VAR="${VAR:-value}"' convention, so precedence is:
#   CLI env  >  inputs.env  >  script defaults
# with zero behavior change when the file is absent. Ship-with-repo template:
# inputs.env.example. Override the location with AP_TOOLS_ENV_FILE=<path>.
AP_TOOLS_ENV_FILE="${AP_TOOLS_ENV_FILE:-$PWD/inputs.env}"
if [[ -f "$AP_TOOLS_ENV_FILE" ]]; then
    env_file_perms=$(stat -c '%a' "$AP_TOOLS_ENV_FILE" 2>/dev/null || echo "")
    if [[ -n "$env_file_perms" ]] && (( 8#$env_file_perms & 2 )); then
        echo "Error: $AP_TOOLS_ENV_FILE is world-writable; refusing to source it."
        echo "  Fix with: chmod o-w '$AP_TOOLS_ENV_FILE'"
        exit 1
    fi
    echo "  Loading inputs from $AP_TOOLS_ENV_FILE (precedence: CLI env > inputs.env > script defaults)"
    # shellcheck disable=SC1090
    source "$AP_TOOLS_ENV_FILE"
fi

