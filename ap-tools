            echo "Error: Registry port must be a number between 1 and 65535."
            exit 1
        fi
    else
        echo "Error: Registry port must be a number between 1 and 65535."
        exit 1
    fi
fi

# --- Main Workflow --- $

os_check
display_args
if [[ $CONFIG_MODE == "1" ]]; then
  # 'config' subcommands are host-preparation helpers: no working dir, no downloads.
  if [[ $CONFIG_TYPE == "hostname" ]]; then
    run_config_hostname
  else
    run_config_static_ip
  fi
  echo "### Automation Tools Finished on $(date) ###"
  exit 0
fi
create_working_dir
if [[ $UNINSTALL_MODE == "1" ]]; then
  run_uninstall
  echo "### Automation Tools Finished on $(date) ###"
  exit 0
fi
if [[ $OFFLINE_PREP_MODE == "1" ]]; then
  run_offline_prep
  echo "Offline archive 'ap-offline.tar.gz' created. Copy the archive to an air-gapped host running the same version of $OS_ID"
fi
if [[ ($INSTALL_MODE == "1" || $JOIN_MODE == "1" || $PUSH_MODE == "1") && ($INSTALL_TYPE != "ap-bundle" && $INSTALL_TYPE != "ddpc-bundle" && $INSTALL_TYPE != "harbor" && $INSTALL_TYPE != "swfs" && $INSTALL_TYPE != "velero" && $INSTALL_TYPE != "monitoring") ]]; then
  [[ $TLS_SAN_MODE == "0" ]] || dns_pre_flight_checks $TLS_SAN
  if [[ $REGISTRY_MODE == "1" ]]; then
    if [[ $REG_FQDN =~ $fqdn_pattern ]]; then
      dns_pre_flight_checks $REG_FQDN
    fi
  fi
  if [[ $INSTALL_MODE == "1" || $JOIN_MODE == "1" ]]; then
    firewalld_selinux_preflight
  fi
  run_install_join_push
fi
if [[ $INSTALL_TYPE == "ap-bundle" ]]; then
  echo "  Preparing Dell Automation Platform bundle..."
  echo "  This may take several minutes..."
  mtls_dns="mtls-$ORCHESTRATOR_FQDN"
  mtls_recovery_dns="mtls-recovery-$ORCHESTRATOR_FQDN"
  if [[ $ORCHESTRATOR_FQDN == "$MGMT_IP" ]]; then
    echo "  IP Based Install detected, skipping DNS checks..."
  else
    dns_pre_flight_checks $PORTAL_FQDN $ORCHESTRATOR_FQDN $mtls_dns $mtls_recovery_dns $REG_FQDN
  fi
  firewalld_selinux_preflight
  ensure_bundle_prereqs
  ap_preflight_checks
  ap_bundle_prep
fi
if [[ $INSTALL_TYPE == "ddpc-bundle" ]]; then
  echo "  Preparing Dell Distributed Private Cloud (DDPC) add-on bundle..."
  echo "  This may take several minutes..."
  if [[ $ORCHESTRATOR_FQDN == "$MGMT_IP" ]]; then
    echo "  IP Based Install detected, skipping DNS checks..."
  elif [[ $REGISTRY_MODE == "1" && $REG_FQDN =~ $fqdn_pattern ]]; then
    dns_pre_flight_checks $ORCHESTRATOR_FQDN $REG_FQDN
  else
    dns_pre_flight_checks $ORCHESTRATOR_FQDN
  fi
  firewalld_selinux_preflight
  ensure_bundle_prereqs
  ddpc_preflight_checks
  ddpc_bundle_prep
fi
if [[ $INSTALL_TYPE == "swfs" ]]; then
  echo "  Installing SeaweedFS artifact server..."
  firewalld_selinux_preflight
  run_install_swfs
fi
if [[ $INSTALL_TYPE == "harbor" ]]; then
  echo "  Installing Harbor registry..."
  firewalld_selinux_preflight
  run_install_harbor
fi
if [[ $INSTALL_TYPE == "velero" ]]; then
  echo "  Installing Velero backup with Longhorn CSI and SeaweedFS S3..."
  run_install_velero
fi
if [[ $INSTALL_TYPE == "monitoring" ]]; then
  echo "  Installing monitoring stack in RKE2 cluster..."
  run_install_monitoring
fi
if [[ $UPGRADE_MODE == "1" ]]; then
  if [[ $REGISTRY_MODE == "1" ]]; then
    if [[ $REG_FQDN =~ $fqdn_pattern ]]; then
      dns_pre_flight_checks $REG_FQDN
    fi
  fi
  run_upgrade_rke2
fi
runtime_outputs
echo "### Automation Tools Finished on $(date) ###"

