create_offline_prep_archive () {
    # saves downloaded files into ap-offline.tar.gz
    echo "  Creating offline archive 'ap-offline.tar.gz'"
    generate_bundle_licenses
    # AP-13: tar with -C $base_dir and stage a copy of this script (plus
    # inputs.env.example when shipped alongside it) into $base_dir first, so
    # offline-prep works when ap-tools is invoked by absolute path from another cwd.
    if [[ "$SCRIPT_PATH" != "$base_dir/ap-tools" ]]; then
        cp "$SCRIPT_PATH" "$base_dir/ap-tools"
        chmod +x "$base_dir/ap-tools"
    fi
    local extra_files=""
    if [[ -f "$(dirname "$SCRIPT_PATH")/inputs.env.example" ]]; then
        if [[ "$(dirname "$SCRIPT_PATH")" != "$base_dir" ]]; then
            cp "$(dirname "$SCRIPT_PATH")/inputs.env.example" "$base_dir/inputs.env.example"
        fi
        extra_files="inputs.env.example"
    fi
    # AP-9: write to a temp name + mv. The archive IS the air-gap sentinel - a partial
    # tar left by an interrupted run would flip every later invocation in this
    # directory into air-gapped mode. tar can never leave a half-written sentinel now.
    # ap-install/bundle is the install-time EXTRACTION of the DAP zip: when
    # offline-prep runs on a host that already did 'install ap-bundle', shipping
    # it alongside the zip doubles the archive (~38G tree + ~19G zip carrying the
    # same payload). The air-gapped target re-extracts from the zip anyway.
    if ! tar -czf "$base_dir/ap-offline.tar.gz.partial" -C "$base_dir" --exclude='ap-install/bundle' --exclude='ap-install/ddpc-bundle' ap-install ap-tools LICENSES $extra_files; then
        rm -f "$base_dir/ap-offline.tar.gz.partial"
        echo "Error: failed to create ap-offline.tar.gz (disk space?). No archive was left behind."
        exit 1
    fi
    mv "$base_dir/ap-offline.tar.gz.partial" "$base_dir/ap-offline.tar.gz"
}

