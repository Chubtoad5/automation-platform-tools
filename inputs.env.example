# ----------------------------------------------------------------------------
# DNS server (Technitium) - 'install dns-server' / 'uninstall dns-server'
# Bare-metal Technitium DNS Server via technitium_dns_installer.sh, meant for its OWN host:
# it binds :53 and takes over the host resolver, so an active rke2 node is refused unless
# DNS_ALLOW_COLOCATION=true. The DNS_DAP_IP & co. inputs seed the DAP / registry / SWFS
# A records (generated zone template; every seeded name must sit under DNS_ZONE).
# ----------------------------------------------------------------------------
#DNS_ADMIN_PASSWORD="${DNS_ADMIN_PASSWORD:-$SWFS_HARBOR_PASS}"   # Technitium 'admin' console password (defaults to the Harbor/SeaweedFS password)
#DNS_ADMIN_CURRENT_PASSWORD="${DNS_ADMIN_CURRENT_PASSWORD:-}"   # Rotation: the previous password when re-running with a NEW DNS_ADMIN_PASSWORD
#DNS_WEB_PORT="${DNS_WEB_PORT:-5380}"                            # Web console HTTP port
#DNS_ENABLE_HTTPS="${DNS_ENABLE_HTTPS:-false}"                   # Self-signed HTTPS console
#DNS_HTTPS_PORT="${DNS_HTTPS_PORT:-53443}"
#DNS_FORWARDERS="${DNS_FORWARDERS:-}"                            # e.g. "1.1.1.1, 8.8.8.8"; empty = root-hint recursion
#DNS_FORWARDER_PROTOCOL="${DNS_FORWARDER_PROTOCOL:-Udp}"         # Udp | Tcp | Tls | Https
#DNS_ENABLE_DNSSEC="${DNS_ENABLE_DNSSEC:-false}"                 # Sign the seeded zones
#DNSSEC_ALGORITHM="${DNSSEC_ALGORITHM:-ECDSA}"                   # ECDSA | RSA | EDDSA
#DNSSEC_CURVE="${DNSSEC_CURVE:-P256}"                            # P256 | P384
#DNS_RECORD_TTL="${DNS_RECORD_TTL:-3600}"
#DNS_DISABLE_SYSTEMD_RESOLVED="${DNS_DISABLE_SYSTEMD_RESOLVED:-true}"  # point this host's resolver at 127.0.0.1
#DNS_ALLOW_COLOCATION="${DNS_ALLOW_COLOCATION:-false}"           # true = allow on a host running rke2 (breaks in-cluster DNS - not recommended)
#DNS_ZONES_TEMPLATE="${DNS_ZONES_TEMPLATE:-}"                    # your own zone/record template; replaces the generated one (seeding inputs ignored)
#DNS_ENABLE_DHCP="${DNS_ENABLE_DHCP:-false}"                     # + DHCP_SCOPE_NAME DHCP_START_ADDRESS DHCP_END_ADDRESS DHCP_SUBNET_MASK DHCP_ROUTER DHCP_DNS_SERVERS
                                                                #   DHCP_DOMAIN DHCP_DNS_SEARCH DHCP_NTP_SERVERS DHCP_DNS_UPDATES DHCP_LEASE_DAYS DHCP_SCOPE_ENABLED (passed through as-is)
#DNS_REMOVE_DOTNET="${DNS_REMOVE_DOTNET:-false}"                 # 'uninstall dns-server' also removes /opt/dotnet
#DNS_ZONE="${DNS_ZONE:-$BASE_DOMAIN}"                            # Primary zone to create
#DNS_DAP_FQDN="${DNS_DAP_FQDN:-$HOST_FQDN}"                      # DAP host (single-node) or cluster (multi-node) FQDN - set it (or HOST_FQDN) on a dedicated DNS host
#DNS_DAP_IP="${DNS_DAP_IP:-}"                                    # DAP ingress IP (host IP single-node, LB_IP multi-node); empty = DAP records not seeded
#DNS_DAP_NODE_IPS="${DNS_DAP_NODE_IPS:-}"                        # Node IPs for the bare DNS_DAP_FQDN record (multi-node -tls-san name, round-robin); empty = DNS_DAP_IP
#DNS_REGISTRY_IP="${DNS_REGISTRY_IP:-}"                          # IP for HARBOR_COMMON_NAME
#DNS_SWFS_IP="${DNS_SWFS_IP:-}"                                  # IP for the four SWFS_*_FQDN names
#DNS_FDO_RV_IP="${DNS_FDO_RV_IP:-}"                              # IP for rv.dell.fdo (air-gapped FDO device onboarding)
#DNS_EXTRA_RECORDS="${DNS_EXTRA_RECORDS:-}"                      # "name=ip,name=ip" (FQDN under DNS_ZONE or a bare label; repeat a name for round-robin)

