# ----------------------------------------------------------------------------
# Dell Distributed Private Cloud (DDPC) add-on - 'install ddpc-bundle'
# Installed INTO the running DAP orchestrator (same cluster/namespace). Every parameter
# of DDPC's install-upgrade.sh is exposed here; DAPO_HOST/NAMESPACE come from
# ORCHESTRATOR_FQDN/ORCHESTRATOR_NAMESPACE above, the registry from -registry (or the
# orchestrator's docker-secret when -registry is omitted).
# ----------------------------------------------------------------------------
#DDPC_BUNDLE_URL="${DDPC_BUNDLE_URL:-https://dl.dell.com/FOLDER14941030M/1/dell-distributed-private-cloud_4.3.0.0.zip}"  # or a pre-staged zip filename in ap-install/
#DOWNLOAD_DDPC_BUNDLE="${DOWNLOAD_DDPC_BUNDLE:-false}"    # Include the ~6GB DDPC bundle in offline-prep
#DDPC_REQUIRED_DAP_VERSION="${DDPC_REQUIRED_DAP_VERSION:-2.1.1.0}"  # exact DAP orchestrator version gate ('any' disables)
#DDPC_SKIP_IMAGES_LOADER="${DDPC_SKIP_IMAGES_LOADER:-$SKIP_IMAGES_LOADER}"  # true = DDPC images already in the registry
#DDPC_IMAGE_LOADER_PARALLEL_JOBS="${DDPC_IMAGE_LOADER_PARALLEL_JOBS:-5}"
#DDPC_IMAGE_LOADER_MAX_RETRIES="${DDPC_IMAGE_LOADER_MAX_RETRIES:-3}"
#DDPC_INSTALL_TYPE="${DDPC_INSTALL_TYPE:-KUBERNETES}"     # KUBERNETES | VIRTUAL_MACHINE (Dell OVA variant, not exercised)
#DDPC_INSTALL_TIMEOUT="${DDPC_INSTALL_TIMEOUT:-600}"      # helm timeout (seconds)
#DDPC_LOG_LEVEL="${DDPC_LOG_LEVEL:-}"                     # DEBUG = echo the helm command
#DDPC_REQUIRED_CPU_HEADROOM="${DDPC_REQUIRED_CPU_HEADROOM:-2}"        # pre-flight: unrequested cores required
#DDPC_REQUIRED_MEM_HEADROOM_GB="${DDPC_REQUIRED_MEM_HEADROOM_GB:-4}"  # pre-flight: unrequested memory (GB) required
#DDPC_REQUIRED_DISK_GB="${DDPC_REQUIRED_DISK_GB:-30}"     # pre-flight: free disk under ap-install/ (zip + extraction + docker load + containerd pull)

